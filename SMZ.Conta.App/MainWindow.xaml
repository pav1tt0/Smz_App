                                                              AutoGenerateColumns="False"
                                                              CanUserAddRows="False"
                                                              IsReadOnly="False"
                                                              MinHeight="120"
                                                              HeadersVisibility="Column"
                                                              RowHeaderWidth="0">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Voce"
                                                                                Width="220"
                                                                                Binding="{Binding Voce, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Header="Misura"
                                                                                Width="140"
                                                                                Binding="{Binding TagliaMisura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Header="Note"
                                                                                Width="*"
                                                                                Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Backup e archivio">
                    <views:BackupArchiveView />
