<Window x:Class="SMZ.Conta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure"
        xmlns:views="clr-namespace:SMZ.Conta.App.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Titolo}"
        Icon="Assets/logo_smz.png"
        Width="1660"
        Height="960"
        MinWidth="1460"
        MinHeight="780"
        WindowState="Maximized"
        Background="#071528"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <SolidColorBrush x:Key="AppNavyBrush" Color="#071A33" />
        <SolidColorBrush x:Key="AppNavyAltBrush" Color="#092446" />
        <SolidColorBrush x:Key="AppBlueBrush" Color="#0E5AA7" />
        <SolidColorBrush x:Key="AppBlueHoverBrush" Color="#176FC5" />
        <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#D5DEE8" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#0D1B3D" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#52647A" />
        <SolidColorBrush x:Key="AppDangerBrush" Color="#D40F1F" />
        <SolidColorBrush x:Key="AppWarningBrush" Color="#EF7D00" />

        <ImageBrush x:Key="HomePhotoBrush"
                    ImageSource="Assets/smz.jpg"
                    Stretch="UniformToFill" />

        <LinearGradientBrush x:Key="WelcomeScreenOverlayBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#B8071528" Offset="0" />
            <GradientStop Color="#96092446" Offset="0.48" />
            <GradientStop Color="#C8071528" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="#C7D2DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#9CC9F5" />
        </Style>

        <Style x:Key="DateTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="ImmersionTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#8FB6D7" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>

        <Style x:Key="ServizioWheelDataGridStyle" TargetType="DataGrid">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF3" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeight" Value="36" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EFF4F9" />
            <Setter Property="Foreground" Value="#243B57" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="ItemsControl">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style x:Key="ServizioWheelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#EFF4F9" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="Foreground" Value="#30465E" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FBFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8D5E2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBlueBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#E9F0F7" />
            <Setter Property="BorderBrush" Value="#CCD9E6" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#0E5AA7" />
            <Setter Property="BorderBrush" Value="#0E5AA7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#E9F2FB" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="14,0,14,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#143A65" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#295D92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0E5AA7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource AppBlueBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeModuleButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="116" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8EB6DC" />
                                <Setter TargetName="CardBorder" Property="Background" Value="#F9FCFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EDF6FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeCardButtonStyle" TargetType="Button" BasedOn="{StaticResource HomeModuleButtonStyle}" />
        <Style x:Key="HomeMiniCardButtonStyle" TargetType="Button" BasedOn="{StaticResource HomeModuleButtonStyle}" />

        <Style x:Key="HomeSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HomeDarkPanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="HeaderHomeButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHomeSection}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeEnterButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#0E5AA7" />
            <Setter Property="BorderBrush" Value="#5CA8F2" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="24,15" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="WelcomeMetaTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2EEF9" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="WelcomeFeatureChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#416C98" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#330E2A4B" />
        </Style>

        <Style x:Key="WelcomeHudCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#416C98" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#260B1F39" />
        </Style>

        <Style x:Key="WelcomeHudLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DBBDA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="WelcomeHudValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="WelcomeAudioButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#163A62" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#416C98" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWelcomeAudioEnabled}" Value="False">
                    <Setter Property="Background" Value="#1F2B3D" />
                    <Setter Property="Foreground" Value="#AEBFD1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource WelcomeAudioButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="21" />
        </Style>

        <Style x:Key="WelcomeMetricCardStyle" TargetType="Border" BasedOn="{StaticResource WelcomeHudCardStyle}" />

        <Style x:Key="WelcomeBubbleStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#22D7F4FF" />
            <Setter Property="Stroke" Value="#80E8FAFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppWorkspaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="312" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                Background="{StaticResource AppNavyBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,18,20,12">
                    <Image Width="216"
                           Height="216"
                           HorizontalAlignment="Center"
                           Source="Assets/logo_smz.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="0,10,0,0"
                               Text="POLIZIA DI STATO"
                               Foreground="#FFFFFF"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Centro Nautico e SMZ"
                               Foreground="#D0DEEE"
                               FontSize="15"
                               TextAlignment="Center" />
                    <Border Margin="0,14,0,0"
                            Height="1"
                            Background="#36506C" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,12">
                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="#FFFFFF" Data="M 3,13 L 13,4 L 23,13 L 20,13 L 20,23 L 15,23 L 15,16 L 11,16 L 11,23 L 6,23 L 6,13 Z" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Dashboard operativa"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="18" Height="17" Stroke="#FFFFFF" StrokeThickness="2.8" RadiusX="2" RadiusY="2" />
                                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="18" Height="5" Fill="#FFFFFF" RadiusX="2" RadiusY="2" />
                                <Rectangle Canvas.Left="8" Canvas.Top="3" Width="3" Height="7" Fill="#FFFFFF" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Canvas.Left="15" Canvas.Top="3" Width="3" Height="7" Fill="#FFFFFF" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Canvas.Left="9" Canvas.Top="15" Width="3" Height="3" Fill="#FFFFFF" />
                                <Rectangle Canvas.Left="14" Canvas.Top="15" Width="3" Height="3" Fill="#FFFFFF" />
                                <Rectangle Canvas.Left="9" Canvas.Top="20" Width="3" Height="3" Fill="#FFFFFF" />
                                <Rectangle Canvas.Left="14" Canvas.Top="20" Width="3" Height="3" Fill="#FFFFFF" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Servizio giornaliero"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Canvas.Left="4" Canvas.Top="4" Width="9" Height="9" Fill="#FFFFFF" />
                                <Ellipse Canvas.Left="15" Canvas.Top="7" Width="7" Height="7" Fill="#FFFFFF" />
                                <Path Fill="#FFFFFF" Data="M 2,24 L 2,20 C 2,15 6,12 11,12 C 16,12 20,15 20,20 L 20,24 Z" />
                                <Path Fill="#FFFFFF" Data="M 16,24 L 16,20 C 16,17 15,15 13,14 C 15,13 17,13 19,13 C 23,13 25,16 25,20 L 25,24 Z" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Personale"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="18" Height="5" Fill="#FFFFFF" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Canvas.Left="6" Canvas.Top="13" Width="14" Height="11" Fill="#FFFFFF" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Canvas.Left="9" Canvas.Top="16" Width="8" Height="2" Fill="#0E5AA7" RadiusX="1" RadiusY="1" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Backup e archivio"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="4">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x20AC;"
                                       FontFamily="Segoe UI"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Contabilita"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="5">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="7" Canvas.Top="2" Width="12" Height="9" Fill="#0E5AA7" Stroke="#FFFFFF" StrokeThickness="2.4" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Canvas.Left="4" Canvas.Top="10" Width="18" Height="11" Fill="#FFFFFF" RadiusX="2" RadiusY="2" />
                                <Rectangle Canvas.Left="7" Canvas.Top="17" Width="12" Height="7" Fill="#0E5AA7" Stroke="#FFFFFF" StrokeThickness="2.4" RadiusX="1.5" RadiusY="1.5" />
                                <Ellipse Canvas.Left="17" Canvas.Top="13" Width="2.5" Height="2.5" Fill="#0E5AA7" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Stampe e report"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SezioneAttivaIndex}" Value="6">
                                        <Setter Property="Background" Value="{StaticResource AppBlueBrush}" />
                                        <Setter Property="BorderBrush" Value="#3985CE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="#FFFFFF"
                                      Data="M 11,2 L 15,2 L 16,5 L 18,6 L 21,5 L 23,9 L 21,11 L 21,15 L 23,17 L 21,21 L 18,20 L 16,21 L 15,24 L 11,24 L 10,21 L 8,20 L 5,21 L 3,17 L 5,15 L 5,11 L 3,9 L 5,5 L 8,6 L 10,5 Z M 13,9 A 4,4 0 1 0 13,17 A 4,4 0 1 0 13,9 Z" />
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="8" Height="8" Fill="#0E5AA7" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Impostazioni operative"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="20,0,20,14">
                    <Border Height="1"
                            Background="#36506C"
                            Margin="0,0,0,12" />
                    <TextBlock Text="Utente: Operatore SMZ"
                               Foreground="#E8F1FA"
                               FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="0"
                Background="{StaticResource AppNavyBrush}"
                BorderBrush="#173A62"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Nucleo Sommozzatori"
                           Foreground="#FFFFFF"
                           FontSize="38"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#D8E4F2"
                                   FontSize="22"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0"
                                   Text="{Binding HeaderDateText}"
                                   Foreground="#D8E4F2"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Width="1"
                            Height="26"
                            Margin="22,0"
                            Background="#607A96" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#D8E4F2"
                                   FontSize="22"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0"
                                   Text="{Binding HeaderTimeText}"
                                   Foreground="#D8E4F2"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Width="1"
                            Height="26"
                            Margin="22,0"
                            Background="#607A96" />
                    <Button Width="104"
                            Height="38"
                            Content="ESCI"
                            Click="CloseAppButton_Click"
                            Style="{DynamicResource WelcomeAudioButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="{StaticResource AppWorkspaceBrush}">
            <ScrollViewer Margin="20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TabControl SelectedIndex="{Binding SezioneAttivaIndex}"
                            Style="{StaticResource HiddenTabControlStyle}">
                    <TabItem Header="Home">
                        <views:HomeView />
                    </TabItem>

                    <TabItem Header="Servizio giornaliero">
                        <views:ServizioGiornalieroView />
                    </TabItem>

                    <TabItem Header="Scheda personale">
                        <views:PersonaleView />
                    </TabItem>

                    <TabItem Header="Backup e archivio">
                        <views:BackupArchiveView />
                    </TabItem>

                    <TabItem Header="Contabilita">
                        <views:ContabilitaView />
                    </TabItem>

                    <TabItem Header="Stampe e report">
                        <views:ReportsView />
                    </TabItem>

                    <TabItem Header="Impostazioni">
                        <views:SettingsView />
                    </TabItem>
                </TabControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="2"
                Background="{StaticResource AppNavyBrush}"
                BorderBrush="#173A62"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Stato}"
                           Foreground="#D8E4F2"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE777;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#D8E4F2"
                               FontSize="20"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,0,0"
                               Text="{Binding BackupLocaleSintesi}"
                               Foreground="#D8E4F2"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <Border Width="1"
                            Height="20"
                            Margin="18,0"
                            Background="#607A96" />
                    <TextBlock Text="{Binding BackupEsternoSintesi}"
                               Foreground="#D8E4F2"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <views:WelcomeView Grid.ColumnSpan="2"
                           Grid.RowSpan="3"
                           Panel.ZIndex="20" />
    </Grid>
</Window>
