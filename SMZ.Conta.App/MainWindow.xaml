<Window x:Class="SMZ.Conta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:SMZ.Conta.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure"
        xmlns:views="clr-namespace:SMZ.Conta.App.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Titolo}"
        Icon="Assets/logo_smz.png"
        Width="1660"
        Height="960"
        MinWidth="1460"
        MinHeight="780"
        WindowState="Maximized"
        Background="#0A1628"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFCF7"/>
            <Setter Property="BorderBrush" Value="#D8E1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DateTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ImmersionTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#9BC2DA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="ServizioWheelDataGridStyle" TargetType="DataGrid">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="ItemsControl">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style x:Key="ServizioWheelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#E6EDF5"/>
            <Setter Property="BorderBrush" Value="#CFDAE5"/>
            <Setter Property="Foreground" Value="#4B6175"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12,12,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F0F5FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#143A63"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFCF7"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C9D8E7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#174E78"/>
            <Setter Property="Foreground" Value="#FFFDF7"/>
            <Setter Property="BorderBrush" Value="#174E78"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#DFE8F1"/>
            <Setter Property="BorderBrush" Value="#DFE8F1"/>
            <Setter Property="Foreground" Value="#17313E"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#CFA032"/>
            <Setter Property="BorderBrush" Value="#CFA032"/>
            <Setter Property="Foreground" Value="#17313E"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#8F3434"/>
            <Setter Property="BorderBrush" Value="#8F3434"/>
            <Setter Property="Foreground" Value="#FFF7F3"/>
        </Style>

        <Style x:Key="HomeCardButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C7D5E2"/>
            <Setter Property="Foreground" Value="#0F2E47"/>
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="MinHeight" Value="128"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.2"
                                    CornerRadius="26"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      ShadowDepth="8"
                                                      Direction="270"
                                                      Opacity="0.18"
                                                      Color="#15314A" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="AccentBar"
                                    Height="8"
                                    Margin="18,16,18,0"
                                    VerticalAlignment="Top"
                                    Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="999" />

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8EA9BE" />
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="30"
                                                          ShadowDepth="12"
                                                          Direction="270"
                                                          Opacity="0.28"
                                                          Color="#173A57" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-4" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
                                <Setter TargetName="AccentBar" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeMiniCardButtonStyle" TargetType="Button" BasedOn="{StaticResource HomeCardButtonStyle}">
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="HomeSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4F73A5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HomeDarkPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F2040"/>
            <Setter Property="BorderBrush" Value="#1E3860"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="HeaderHomeButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#F5FAFF"/>
            <Setter Property="BorderBrush" Value="#7FA8DA"/>
            <Setter Property="Foreground" Value="#10274B"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHomeSection}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeEnterButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2D37B" Offset="0" />
                        <GradientStop Color="#C7962B" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E1B24C"/>
            <Setter Property="Foreground" Value="#13293F"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="WelcomeMetaTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8C2DF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="WelcomeFeatureChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#3E688B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#160F2237"/>
        </Style>

        <Style x:Key="WelcomeHudCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="#3F6587"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1A0D1D30"/>
        </Style>

        <Style x:Key="WelcomeHudLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FA8DA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="WelcomeHudValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7FAFD"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WelcomeAudioButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#1D2740"/>
            <Setter Property="Foreground" Value="#EAF3FB"/>
            <Setter Property="BorderBrush" Value="#4E7090"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWelcomeAudioEnabled}" Value="True">
                    <Setter Property="Background" Value="#264B65"/>
                    <Setter Property="BorderBrush" Value="#79BCD9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWelcomeAudioEnabled}" Value="False">
                    <Setter Property="Background" Value="#202735"/>
                    <Setter Property="BorderBrush" Value="#4D5C73"/>
                    <Setter Property="Foreground" Value="#AFC1D3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeMetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Background" Value="#140D1F33"/>
            <Setter Property="BorderBrush" Value="#345B7B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="WelcomeBubbleStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#18D7F4FF"/>
            <Setter Property="Stroke" Value="#8BE8FAFF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                        <TranslateTransform />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <BlurEffect Radius="0.4" />
                </Setter.Value>
            </Setter>
        </Style>

        <ImageBrush x:Key="HomePhotoBrush"
                    ImageSource="Assets/smz.jpg"
                    Stretch="UniformToFill" />

        <LinearGradientBrush x:Key="WelcomeScreenOverlayBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#D9061120" Offset="0" />
            <GradientStop Color="#C4122943" Offset="0.36" />
            <GradientStop Color="#E4081220" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#2A5298"
                BorderThickness="1.4"
                CornerRadius="22"
                Padding="20"
                Margin="0,0,0,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D2040" Offset="0" />
                    <GradientStop Color="#1A3A6B" Offset="0.52" />
                    <GradientStop Color="#0D2040" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Image Width="124"
                       Height="94"
                       Source="Assets/logo_smz.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="POLIZIA DI STATO"
                            FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#D7E5F7"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,4,0,0"
                               Text="NUCLEO SOMMOZZATORI"
                               FontSize="21"
                               Foreground="#7FA8DA"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Gestione operativa di servizi giornalieri, personale e contabilita"
                               FontSize="13"
                               Foreground="#5F8CCC"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="2" Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="← Home"
                                Command="{Binding NavigateSectionCommand}"
                                CommandParameter="0"
                                ToolTip="Torna alla schermata iniziale"
                                Style="{StaticResource HeaderHomeButtonStyle}" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Height="94"
                            CornerRadius="18"
                            BorderBrush="#284A78"
                            BorderThickness="1.2"
                            Background="{StaticResource HomePhotoBrush}"
                            VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TabControl SelectedIndex="{Binding SezioneAttivaIndex}"
                        Style="{StaticResource HiddenTabControlStyle}">
                <TabItem Header="Home">
                    <views:HomeView />
                </TabItem>

                <TabItem Header="Servizio giornaliero">
                    <views:ServizioGiornalieroView />
                </TabItem>

                <TabItem Header="Scheda personale">
                    <views:PersonaleView />
                </TabItem>

                <TabItem Header="Backup e archivio">
                    <views:BackupArchiveView />
                </TabItem>

                <TabItem Header="Contabilita">
                    <views:ContabilitaView />
                </TabItem>

                <TabItem Header="Stampe e report">
                    <views:ReportsView />
                </TabItem>

                <TabItem Header="Impostazioni">
                    <views:SettingsView />
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Background="#DDE7E2"
                CornerRadius="18"
                Padding="14,10">
            <TextBlock Text="{Binding Stato}"
                       Foreground="#17313E"
                       FontSize="14" />
        </Border>

        <views:WelcomeView Grid.RowSpan="3"
                           Panel.ZIndex="20" />

    </Grid>
</Window>
