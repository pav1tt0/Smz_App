                                                                                 BorderBrush="#B7C7D1"
                                                                                 BorderThickness="1"
                                                                                 HorizontalContentAlignment="Left"
                                                                                 VerticalContentAlignment="Center"
                                                                                 Text="{Binding TagliaMisura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Background="White"
                                                            BorderBrush="#D6E0E7"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top">
                                                        <Image Source="/Assets/Figura_taglie.png"
                                                               MaxWidth="300"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Margin="0,16,0,0"
                                                    Padding="16"
