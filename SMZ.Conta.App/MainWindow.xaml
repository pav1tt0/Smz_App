                                        <TextBlock Text="PERSONALE, BACKUP E ARCHIVIO"
                                                   Foreground="#FFF7DC"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Schede, recuperi e copie dati"
                                                   Foreground="#A9C6E2"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

