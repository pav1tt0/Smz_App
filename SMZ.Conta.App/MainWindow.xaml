                                                                                <MultiBinding StringFormat="{}{0} - {1}">
                                                                                    <Binding Path="NumeroScheda" />
                                                                                    <Binding Path="EtichettaScheda" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>

                                                                        <TextBlock Grid.Column="1"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Right"
                                                                                   FontSize="17"
                                                                                   Foreground="#0F2430"
