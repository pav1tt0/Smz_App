                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,12,0,0"
                                                           Text="{Binding DashboardArchivioSintesi}"
                                                           Foreground="#C8D8E9"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,14,0,0"
                                                           Text="{Binding DashboardScadenzeSintesi}"
                                                           Foreground="#9FBBD6"
                                                           TextWrapping="Wrap" />
