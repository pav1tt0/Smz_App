                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,18">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="260" />
                                                                            <ColumnDefinition Width="56" />
                                                                            <ColumnDefinition Width="130" />
                                                                        </Grid.ColumnDefinitions>

