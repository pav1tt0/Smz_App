                                                           Foreground="#F9E7B0"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,12,0,0"
                                                           Text="{Binding DashboardServizioSintesi}"
                                                           Foreground="#C8D8E9"
                                                           TextWrapping="Wrap" />
