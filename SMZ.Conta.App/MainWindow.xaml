                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           Foreground="#17313E" />

                                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="Tipo abilitazione" Foreground="#50626A" />
