<UserControl x:Class="SMZ.Conta.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="20"
                            Height="20"
                            Background="#0E5AA7"
                            CornerRadius="4"
                            VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0"
                               Text="Moduli principali"
                               Foreground="#0D1B3D"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <UniformGrid Grid.Row="2"
                             Columns="6">
                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="1"
                            Style="{DynamicResource HomeModuleButtonStyle}"
                            Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#EAF3FD"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="SG"
                                           Foreground="#0E5AA7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Servizio giornaliero"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B3D" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Pianificazione e turni"
                                           FontSize="12"
                                           Foreground="#52647A" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="2"
                            Style="{DynamicResource HomeModuleButtonStyle}"
                            Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#EAF3FD"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PE"
                                           Foreground="#0E5AA7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Personale"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B3D" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Anagrafica e qualifiche"
                                           FontSize="12"
                                           Foreground="#52647A" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="3"
                            Style="{DynamicResource HomeModuleButtonStyle}"
                            Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#EAF3FD"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="BA"
                                           Foreground="#0E5AA7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Backup e archivio"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B3D" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Dati e documenti storici"
                                           FontSize="12"
                                           Foreground="#52647A" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="4"
                            Style="{DynamicResource HomeModuleButtonStyle}"
                            Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#EAF3FD"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="CO"
                                           Foreground="#0E5AA7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Contabilita"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B3D" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Movimenti e bilanci"
                                           FontSize="12"
                                           Foreground="#52647A" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="5"
                            Style="{DynamicResource HomeModuleButtonStyle}"
                            Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#EAF3FD"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="SR"
                                           Foreground="#0E5AA7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Stampe e report"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B3D" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Stampe e documenti"
                                           FontSize="12"
                                           Foreground="#52647A" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateSectionCommand}"
                            CommandParameter="6"
                            Style="{DynamicResource HomeModuleButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#EAF3FD"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="IM"
                                           Foreground="#0E5AA7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Impostazioni"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B3D" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Cataloghi operativi"
                                           FontSize="12"
                                           Foreground="#52647A" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.86*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.04*" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Stato nucleo"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#0D1B3D" />
                    <Grid Grid.Row="1"
                          Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="84"
                                Height="84"
                                Background="#EAF3FD"
                                CornerRadius="42"
                                VerticalAlignment="Top">
                            <TextBlock Text="PE"
                                       Foreground="#0E5AA7"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{Binding DashboardStatoSintesi}"
                                       Foreground="#0D1B3D"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,16,0,0"
                                       Text="{Binding DashboardServizioSintesi}"
                                       Foreground="#52647A"
                                       FontSize="14"
                                       LineHeight="22"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding DashboardArchivioSintesi}"
                                       Foreground="#52647A"
                                       FontSize="14"
                                       LineHeight="22"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scadenze personale"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#0D1B3D" />

                    <Grid Grid.Row="1"
                          Margin="0,18,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFF3F4"
                                BorderBrush="#F3B3B8"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DashboardVisiteScadutePersonale}"
                                           Foreground="#D40F1F"
                                           FontSize="18"
                                           FontWeight="Bold" />
                                <TextBlock Margin="10,0,0,0"
                                           Text="Scadute"
                                           Foreground="#D40F1F"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Background="#FFF7EB"
                                BorderBrush="#F2C78F"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DashboardVisiteInScadenzaPersonale}"
                                           Foreground="#EF7D00"
                                           FontSize="18"
                                           FontWeight="Bold" />
                                <TextBlock Margin="10,0,0,0"
                                           Text="In scadenza"
                                           Foreground="#EF7D00"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="#D5DEE8"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ItemsControl ItemsSource="{Binding DashboardTopScadenze}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0"
                                            Margin="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Command="{Binding DataContext.OpenScadenzaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid MinHeight="52"
                                              Margin="14,0"
                                              Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Nominativo}"
                                                       Foreground="#0D1B3D"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Titolo}"
                                                       Foreground="#0D1B3D"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CriticitaDataText}"
                                                       Foreground="{Binding TitoloForeground}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Button Grid.Row="3"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            MinWidth="0"
                            Content="Vai all'elenco"
                            Command="{Binding NavigateSectionCommand}"
                            CommandParameter="2"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Criticita personale"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#D40F1F" />
                        <Border Grid.Column="1"
                                MinWidth="34"
                                Height="30"
                                Padding="8,0"
                                Background="#D40F1F"
                                CornerRadius="6">
                            <TextBlock Text="{Binding DashboardCriticitaItems.Count}"
                                       Foreground="#FFFFFF"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  Margin="0,24,0,0"
                                  ItemsSource="{Binding DashboardCriticitaItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="0"
                                        Margin="0,0,0,8"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Command="{Binding DataContext.OpenScadenzaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid MinHeight="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Nominativo}"
                                                   Foreground="#0D1B3D"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Titolo}"
                                                   Foreground="#0D1B3D"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CriticitaBadgeText}"
                                                   Foreground="{Binding TitoloForeground}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="2"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            MinWidth="0"
                            Content="Vai all'elenco"
                            Command="{Binding NavigateSectionCommand}"
                            CommandParameter="2"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
