<UserControl x:Class="SMZ.Conta.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

        <Grid Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#C7061320"
                    CornerRadius="28" />

            <Border Margin="12"
                    CornerRadius="30"
                    Background="Transparent"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="44"
                                      ShadowDepth="14"
                                      Direction="270"
                                      Opacity="0.34"
                                      Color="#02070D" />
                </Border.Effect>

                <Grid>
                    <Border Background="{DynamicResource HomePhotoBrush}" />
                    <Rectangle Fill="{DynamicResource WelcomeScreenOverlayBrush}" />

                    <Ellipse Width="760"
                             Height="280"
                             Margin="0,-136,0,0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Opacity="0.32"
                             IsHitTestVisible="False"
                             RenderTransformOrigin="0.5,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.18">
                                <GradientStop Color="#D3A94A" Offset="0" />
                                <GradientStop Color="#7CC7E7F3" Offset="0.34" />
                                <GradientStop Color="#00C7E7F3" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <BlurEffect Radius="64" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.26"
                                                         To="0.42"
                                                         Duration="0:0:6.8" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0.96"
                                                         To="1.05"
                                                         Duration="0:0:6.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Rectangle Height="1"
                               Margin="64,108,64,0"
                               VerticalAlignment="Top"
                               Fill="#4295C5EA"
                               Opacity="0.56"
                               IsHitTestVisible="False" />

                    <Rectangle Width="1"
                               Height="250"
                               Margin="0,150,220,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Fill="#225A84A8"
                               IsHitTestVisible="False" />

                    <Rectangle Width="1"
                               Height="210"
                               Margin="0,220,116,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Fill="#184F789A"
                               IsHitTestVisible="False" />

                    <Ellipse Width="124"
                             Height="124"
                             Margin="0,140,300,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Fill="#18A3D8F4"
                             Stroke="#56C1E6F8"
                             StrokeThickness="1"
                             Opacity="0.22"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <BlurEffect Radius="8" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.16"
                                                         To="0.32"
                                                         Duration="0:0:8" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="0"
                                                         To="-26"
                                                         Duration="0:0:8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Width="88"
                             Height="88"
                             Margin="0,430,420,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Fill="#16C8E5FF"
                             Stroke="#5AA2D0F0"
                             StrokeThickness="1"
                             Opacity="0.18"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <BlurEffect Radius="6" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.12"
                                                         To="0.28"
                                                         Duration="0:0:10" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="0"
                                                         To="-18"
                                                         Duration="0:0:10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Width="154"
                             Height="154"
                             Margin="160,0,0,110"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Fill="#12A8D6EE"
                             Stroke="#4690C2E6"
                             StrokeThickness="1"
                             Opacity="0.16"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <BlurEffect Radius="10" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.1"
                                                         To="0.24"
                                                         Duration="0:0:11" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="0"
                                                         To="-20"
                                                         Duration="0:0:11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Canvas ClipToBounds="True"
                            IsHitTestVisible="False">
                        <Ellipse Canvas.Left="120"
                                 Canvas.Bottom="-46"
                                 Width="18"
                                 Height="18"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.62"
                                                             Duration="0:0:2.1"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-860"
                                                             Duration="0:0:12.5" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="42"
                                                             Duration="0:0:12.5"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Left="240"
                                 Canvas.Bottom="-70"
                                 Width="10"
                                 Height="10"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:2.4">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.48"
                                                             Duration="0:0:1.8"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-760"
                                                             Duration="0:0:10.8" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="-26"
                                                             Duration="0:0:10.8"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Left="520"
                                 Canvas.Bottom="-58"
                                 Width="14"
                                 Height="14"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.2">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.52"
                                                             Duration="0:0:2"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-820"
                                                             Duration="0:0:11.7" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="34"
                                                             Duration="0:0:11.7"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Left="430"
                                 Canvas.Bottom="-38"
                                 Width="8"
                                 Height="8"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:4.2">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.42"
                                                             Duration="0:0:1.5"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-690"
                                                             Duration="0:0:9.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="-18"
                                                             Duration="0:0:9.2"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Left="690"
                                 Canvas.Bottom="-64"
                                 Width="17"
                                 Height="17"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:6.1">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.54"
                                                             Duration="0:0:2"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-840"
                                                             Duration="0:0:12.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="38"
                                                             Duration="0:0:12.2"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Left="860"
                                 Canvas.Bottom="-48"
                                 Width="9"
                                 Height="9"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.8">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.4"
                                                             Duration="0:0:1.6"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-730"
                                                             Duration="0:0:10.1" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="-30"
                                                             Duration="0:0:10.1"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Right="340"
                                 Canvas.Bottom="-62"
                                 Width="22"
                                 Height="22"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:3.1">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.58"
                                                             Duration="0:0:2.2"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-900"
                                                             Duration="0:0:13.6" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="-44"
                                                             Duration="0:0:13.6"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Right="210"
                                 Canvas.Bottom="-42"
                                 Width="12"
                                 Height="12"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:5">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.46"
                                                             Duration="0:0:1.7"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-720"
                                                             Duration="0:0:9.8" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="24"
                                                             Duration="0:0:9.8"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Right="520"
                                 Canvas.Bottom="-74"
                                 Width="15"
                                 Height="15"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:7.3">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.5"
                                                             Duration="0:0:1.9"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-790"
                                                             Duration="0:0:11.1" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="28"
                                                             Duration="0:0:11.1"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Canvas.Right="90"
                                 Canvas.Bottom="-56"
                                 Width="7"
                                 Height="7"
                                 Style="{DynamicResource WelcomeBubbleStyle}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:3.8">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.38"
                                                             Duration="0:0:1.4"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="0"
                                                             To="-650"
                                                             Duration="0:0:8.7" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="0"
                                                             To="-20"
                                                             Duration="0:0:8.7"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Canvas>

                    <Viewbox Margin="28"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <Grid Width="1480"
                              Height="820">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0"
                                    Width="660"
                                    Margin="0,20,38,40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border HorizontalAlignment="Center"
                                    Padding="20,12"
                                    CornerRadius="999"
                                    Background="#140C1D31"
                                    BorderBrush="#53779C"
                                    BorderThickness="1">
                                <TextBlock Text="GESTIONALE OPERATIVO - NUCLEO SOMMOZZATORI"
                                           Foreground="#DDEAF7"
                                           FontSize="16"
                                           FontWeight="Bold" />
                            </Border>

                            <TextBlock Margin="0,30,0,0"
                                       Text="{Binding WelcomeTitolo}"
                                       FontSize="54"
                                       FontWeight="Bold"
                                       Foreground="#FFFDF7"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap" />

                            <TextBlock Margin="0,10,0,0"
                                       Text="LA SPEZIA"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       TextAlignment="Center" />

                            <Image Width="182"
                                   Height="138"
                                   Margin="0,28,0,0"
                                   Source="Assets/logo_smz.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" />

                            <TextBlock Margin="0,24,0,0"
                                       MaxWidth="560"
                                       Text="{Binding WelcomeSottotitolo}"
                                       FontSize="19"
                                       Foreground="#D9E5F2"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,28,0,0"
                                       HorizontalAlignment="Center"
                                       ItemHeight="64"
                                       MaxWidth="620">
                                <Border Style="{DynamicResource WelcomeFeatureChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="SERVIZI GIORNALIERI"
                                                   Foreground="#FFF7DC"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Pianificazione rapida"
                                                   Foreground="#A9C6E2"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource WelcomeFeatureChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="PERSONALE, BACKUP E ARCHIVIO"
                                                   Foreground="#FFF7DC"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Schede, recuperi e copie dati"
                                                   Foreground="#A9C6E2"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource WelcomeFeatureChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CONTABILITA E REPORT"
                                                   Foreground="#FFF7DC"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Visione unificata del reparto"
                                                   Foreground="#A9C6E2"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Button Margin="0,34,0,0"
                                    Content="Entra nel gestionale"
                                    Command="{Binding EnterAppCommand}"
                                    IsDefault="True"
                                    HorizontalAlignment="Center"
                                    Style="{DynamicResource WelcomeEnterButtonStyle}" />

                            <TextBlock Margin="0,16,0,0"
                                       MaxWidth="520"
                                       Text="Accesso diretto alla home iniziale con dashboard, anagrafica, servizi, immersioni e riepiloghi."
                                       Foreground="#A8C2DF"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="AUDIO"
                                Command="{Binding ToggleWelcomeAudioCommand}"
                                ToolTip="{Binding WelcomeAudioTooltip}"
                                Style="{DynamicResource WelcomeAudioButtonStyle}" />

                        <Grid Grid.Column="1"
                              Grid.Row="1"
                              Margin="24,26,0,48">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource WelcomeHudCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="PANORAMICA OPERATIVA"
                                                   Style="{DynamicResource WelcomeHudLabelStyle}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="{Binding DashboardStatoSintesi}"
                                                   Foreground="#F4F8FC"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,10,0,0"
                                                   Text="{Binding DashboardScadenzeSintesi}"
                                                   Foreground="#AFC8E0"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <UniformGrid Grid.Row="2"
                                                 Columns="2">
                                        <Border Style="{DynamicResource WelcomeMetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="PERSONALE"
                                                           Style="{DynamicResource WelcomeHudLabelStyle}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           Text="{Binding DashboardDipendentiTotali}"
                                                           Style="{DynamicResource WelcomeHudValueStyle}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="operatori registrati"
                                                           Foreground="#A9C1D8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{DynamicResource WelcomeMetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="SCADENZE"
                                                           Style="{DynamicResource WelcomeHudLabelStyle}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           Text="{Binding DashboardScadenzeAperte}"
                                                           Style="{DynamicResource WelcomeHudValueStyle}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="voci da monitorare"
                                                           Foreground="#A9C1D8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{DynamicResource WelcomeMetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="VISITE"
                                                           Style="{DynamicResource WelcomeHudLabelStyle}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           Text="{Binding DashboardVisiteInScadenzaPersonale}"
                                                           Style="{DynamicResource WelcomeHudValueStyle}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="personale in scadenza"
                                                           Foreground="#A9C1D8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,0,0,16"
                                                CornerRadius="20"
                                                Padding="18"
                                                Background="#140D1F33"
                                                BorderBrush="#345B7B"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="MODULI"
                                                           Style="{DynamicResource WelcomeHudLabelStyle}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           Text="{Binding DashboardCataloghiServizioTotali}"
                                                           Style="{DynamicResource WelcomeHudValueStyle}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="cataloghi operativi"
                                                           Foreground="#A9C1D8" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                                CornerRadius="20"
                                                Padding="18"
                                                Background="#120C2036"
                                                BorderBrush="#31597B"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="SERVIZI GIORNALIERI"
                                                           Foreground="#F9E7B0"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,12,0,0"
                                                           Text="{Binding DashboardServizioSintesi}"
                                                           Foreground="#C8D8E9"
                                                           TextWrapping="Wrap" />
                                                <Border Margin="0,16,0,0"
                                                        Height="6"
                                                        HorizontalAlignment="Stretch"
                                                        Background="#193C5674"
                                                        CornerRadius="999">
                                                    <Border Width="150"
                                                            HorizontalAlignment="Left"
                                                            Background="#F2D37B"
                                                            CornerRadius="999" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                CornerRadius="20"
                                                Padding="18"
                                                Background="#120C2036"
                                                BorderBrush="#31597B"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DashboardTopScadenzeTitolo}"
                                                           Foreground="#F9E7B0"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,12,0,0"
                                                           Text="{Binding DashboardArchivioSintesi}"
                                                           Foreground="#C8D8E9"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,14,0,0"
                                                           Text="{Binding DashboardScadenzeSintesi}"
                                                           Foreground="#9FBBD6"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="{Binding WelcomeCredits}"
                                       Style="{DynamicResource WelcomeMetaTextStyle}" />
                        </StackPanel>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
</UserControl>
