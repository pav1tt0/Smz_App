<UserControl x:Class="SMZ.Conta.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Background="#D8071528" />

        <Border Margin="18"
                CornerRadius="10"
                Background="#071A33"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="12"
                                  Direction="270"
                                  Opacity="0.32"
                                  Color="#02070D" />
            </Border.Effect>

            <Grid>
                <Border Background="{DynamicResource HomePhotoBrush}"
                        Opacity="0.68" />
                <Rectangle Fill="{DynamicResource WelcomeScreenOverlayBrush}" />

                <Canvas IsHitTestVisible="False"
                        ClipToBounds="True">
                    <Ellipse x:Name="WelcomeBubbleOne"
                             Width="18"
                             Height="18"
                             Canvas.Left="118"
                             Canvas.Top="760"
                             Style="{DynamicResource WelcomeBubbleStyle}" />
                    <Ellipse x:Name="WelcomeBubbleTwo"
                             Width="28"
                             Height="28"
                             Canvas.Left="248"
                             Canvas.Top="830"
                             Style="{DynamicResource WelcomeBubbleStyle}" />
                    <Ellipse x:Name="WelcomeBubbleThree"
                             Width="14"
                             Height="14"
                             Canvas.Left="980"
                             Canvas.Top="780"
                             Style="{DynamicResource WelcomeBubbleStyle}" />
                    <Ellipse x:Name="WelcomeBubbleFour"
                             Width="22"
                             Height="22"
                             Canvas.Left="1220"
                             Canvas.Top="850"
                             Style="{DynamicResource WelcomeBubbleStyle}" />
                    <Ellipse x:Name="WelcomeBubbleFive"
                             Width="12"
                             Height="12"
                             Canvas.Left="520"
                             Canvas.Top="810"
                             Style="{DynamicResource WelcomeBubbleStyle}" />
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Canvas.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="WelcomeBubbleOne"
                                                     Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="760"
                                                     To="-40"
                                                     Duration="0:0:18"
                                                     RepeatBehavior="Forever" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WelcomeBubbleOne"
                                                                   Storyboard.TargetProperty="Opacity"
                                                                   RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0.55" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:15" Value="0.35" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:18" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <DoubleAnimation Storyboard.TargetName="WelcomeBubbleTwo"
                                                     Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="830"
                                                     To="-60"
                                                     Duration="0:0:24"
                                                     BeginTime="0:0:4"
                                                     RepeatBehavior="Forever" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WelcomeBubbleTwo"
                                                                   Storyboard.TargetProperty="Opacity"
                                                                   BeginTime="0:0:4"
                                                                   RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:4" Value="0.45" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0.32" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:24" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <DoubleAnimation Storyboard.TargetName="WelcomeBubbleThree"
                                                     Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="780"
                                                     To="-35"
                                                     Duration="0:0:20"
                                                     BeginTime="0:0:8"
                                                     RepeatBehavior="Forever" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WelcomeBubbleThree"
                                                                   Storyboard.TargetProperty="Opacity"
                                                                   BeginTime="0:0:8"
                                                                   RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0.5" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:17" Value="0.3" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <DoubleAnimation Storyboard.TargetName="WelcomeBubbleFour"
                                                     Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="850"
                                                     To="-50"
                                                     Duration="0:0:28"
                                                     BeginTime="0:0:2"
                                                     RepeatBehavior="Forever" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WelcomeBubbleFour"
                                                                   Storyboard.TargetProperty="Opacity"
                                                                   BeginTime="0:0:2"
                                                                   RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0.4" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:24" Value="0.28" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:28" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <DoubleAnimation Storyboard.TargetName="WelcomeBubbleFive"
                                                     Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="810"
                                                     To="-30"
                                                     Duration="0:0:22"
                                                     BeginTime="0:0:12"
                                                     RepeatBehavior="Forever" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WelcomeBubbleFive"
                                                                   Storyboard.TargetProperty="Opacity"
                                                                   BeginTime="0:0:12"
                                                                   RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0.46" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:18" Value="0.3" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:22" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                </Canvas>

                <Button Margin="34,0,0,34"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Content="&#xE767;"
                        Command="{Binding ToggleWelcomeAudioCommand}"
                        ToolTip="{Binding WelcomeAudioTooltip}"
                        Style="{DynamicResource WelcomeIconButtonStyle}" />

                <StackPanel Margin="0,28,34,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Width="104"
                            Height="38"
                            Content="ESCI"
                            Click="CloseAppButton_Click"
                            Style="{DynamicResource WelcomeAudioButtonStyle}" />
                </StackPanel>

                <Viewbox Margin="70,58,70,38"
                         Stretch="Uniform"
                         StretchDirection="DownOnly">
                    <Grid Width="1420"
                          Height="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="46" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center"
                                        Margin="0">
                                <TextBlock Width="700"
                                           Text="POLIZIA DI STATO"
                                           Foreground="#FFFFFF"
                                           FontSize="68"
                                           FontWeight="Bold"
                                           LineHeight="72"
                                           TextAlignment="Center"
                                           TextWrapping="NoWrap" />
                                <TextBlock Width="700"
                                           Margin="0,12,0,0"
                                           Text="CENTRO NAUTICO E SMZ"
                                           Foreground="#D3E2F2"
                                           FontSize="38"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="NoWrap" />
                                <TextBlock Width="700"
                                           Margin="0,8,0,0"
                                           Text="NUCLEO SOMMOZZATORI"
                                           Foreground="#FFFFFF"
                                           FontSize="38"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="NoWrap" />
                                <TextBlock Margin="0,30,0,0"
                                           Width="700"
                                           Text="Gestionale operativo per servizi giornalieri, personale&#x0a;immersioni, archivio e contabilita."
                                           Foreground="#DDE8F4"
                                           FontSize="20"
                                           LineHeight="32"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <Button Margin="0,48,0,0"
                                        Width="390"
                                        Height="78"
                                        Content="Entra nel gestionale"
                                        Command="{Binding EnterAppCommand}"
                                        IsDefault="True"
                                        HorizontalAlignment="Center"
                                        Style="{DynamicResource WelcomeEnterButtonStyle}" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                                <Image Width="620"
                                       Height="620"
                                       Source="/SMZ.App;component/Assets/logo_smz.png"
                                       Stretch="Uniform">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          ShadowDepth="8"
                                                          Direction="270"
                                                          Opacity="0.48"
                                                          Color="#02070D" />
                                    </Image.Effect>
                                </Image>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeCredits}"
                                       Style="{DynamicResource WelcomeMetaTextStyle}" />
                            <TextBlock Margin="18,0"
                                       Text="|"
                                       Style="{DynamicResource WelcomeMetaTextStyle}" />
                            <TextBlock Text="{Binding WelcomeVersione}"
                                       Style="{DynamicResource WelcomeMetaTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
