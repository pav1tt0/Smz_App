<UserControl x:Class="SMZ.Conta.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Background="#D8071528" />

        <Border Margin="18"
                CornerRadius="10"
                Background="#071A33"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="12"
                                  Direction="270"
                                  Opacity="0.32"
                                  Color="#02070D" />
            </Border.Effect>

            <Grid>
                <Border Background="{DynamicResource HomePhotoBrush}"
                        Opacity="0.46" />
                <Rectangle Fill="{DynamicResource WelcomeScreenOverlayBrush}" />

                <Button Width="104"
                        Height="38"
                        Margin="0,28,34,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Content="AUDIO"
                        Command="{Binding ToggleWelcomeAudioCommand}"
                        ToolTip="{Binding WelcomeAudioTooltip}"
                        Style="{DynamicResource WelcomeAudioButtonStyle}" />

                <Viewbox Margin="70,58,70,38"
                         Stretch="Uniform"
                         StretchDirection="DownOnly">
                    <Grid Width="1420"
                          Height="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="46" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,58,0">
                                <TextBlock Text="Nucleo Sommozzatori"
                                           Foreground="#FFFFFF"
                                           FontSize="64"
                                           FontWeight="Bold"
                                           LineHeight="70"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Text="POLIZIA DI STATO"
                                           Foreground="#FFFFFF"
                                           FontSize="26"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="Centro Nautico e SMZ"
                                           Foreground="#D3E2F2"
                                           FontSize="25" />
                                <TextBlock Margin="0,30,0,0"
                                           MaxWidth="680"
                                           Text="Gestionale operativo per servizi giornalieri, personale, immersioni, archivio e contabilita."
                                           Foreground="#DDE8F4"
                                           FontSize="20"
                                           LineHeight="32"
                                           TextWrapping="Wrap" />

                                <Button Margin="0,42,0,0"
                                        Width="310"
                                        Height="64"
                                        Content="Entra nel gestionale"
                                        Command="{Binding EnterAppCommand}"
                                        IsDefault="True"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource WelcomeEnterButtonStyle}" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                                <Border Width="460"
                                        Height="460"
                                        Background="#26071528"
                                        BorderBrush="#466D98"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="34">
                                    <Image Source="/SMZ.App;component/Assets/logo_smz.png"
                                           Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Text="{Binding WelcomeCredits}"
                                       Style="{DynamicResource WelcomeMetaTextStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding WelcomeVersione}"
                                       Style="{DynamicResource WelcomeMetaTextStyle}" />
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
