<UserControl x:Class="SMZ.Conta.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SMZ.Conta.App.Controls">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Stampe e Report"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#17313E" />
                <TextBlock Margin="0,10,0,0"
                           Text="Area unica per cercare dati salvati, preparare stampe e consultare report operativi."
                           Foreground="#53646A"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Servizi">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Stampa servizio giornaliero"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ServiziSalvatiStato}"
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="Cerca un servizio salvato per data, mese, numero ordine o localita, poi stampa il servizio selezionato."
                                           Foreground="#6A7B80"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Width="210">
                                    <TextBlock Text="Localita"
                                               Foreground="#50626A" />
                                    <TextBox Text="{Binding ServiziSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Cerca per localita" />
                                </StackPanel>

                                <StackPanel Width="120"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="N. servizio"
                                               Foreground="#50626A" />
                                    <TextBox Text="{Binding ServiziNumeroSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Numero servizio" />
                                </StackPanel>

                                <StackPanel Width="130"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Data o mese"
                                               Foreground="#50626A" />
                                    <controls:DateInputPicker Text="{Binding ServiziDataSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                              AutoFormatText="False"
                                                              ShowMonthShortcut="True"
                                                              Width="120"
                                                              ToolTip="{Binding ServiziDataSearchToolTip}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        Content="Pulisci"
                                        Command="{Binding ClearServiziSearchCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="12,20,0,0"
                                        Content="Stampa servizio"
                                        Command="{Binding PrintServizioSelezionatoCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Servizi trovati"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#17313E" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="La selezione qui alimenta la stampa del servizio giornaliero."
                                               Foreground="#53646A" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal">
                                    <Button Content="Apri servizio"
                                            Command="{Binding OpenServizioCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                    <Button Content="Esporta pacchetto"
                                            Command="{Binding ExportServizioPackageCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ServiziSalvati}"
                                      SelectedItem="{Binding SelectedServizioSalvato}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"
                                                        Width="95"
                                                        Binding="{Binding DataServizio, StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn Header="Ordine"
                                                        Width="120"
                                                        Binding="{Binding NumeroOrdineServizio}" />
                                    <DataGridTextColumn Header="Orario"
                                                        Width="110"
                                                        Binding="{Binding OrarioServizio}" />
                                    <DataGridTextColumn Header="Localita"
                                                        Width="1.2*"
                                                        Binding="{Binding LocalitaDescrizione}" />
                                    <DataGridTextColumn Header="Scopo"
                                                        Width="1.4*"
                                                        Binding="{Binding ScopoDescrizione}" />
                                    <DataGridTextColumn Header="Mezzo"
                                                        Width="1*"
                                                        Binding="{Binding UnitaNavaleDescrizione}" />
                                    <DataGridTextColumn Header="Presenti"
                                                        Width="80"
                                                        Binding="{Binding PresentiTotali}" />
                                    <DataGridTextColumn Header="Imm."
                                                        Width="65"
                                                        Binding="{Binding ImmersioniTotali}" />
                                    <DataGridCheckBoxColumn Header="Fuori sede"
                                                            Width="90"
                                                            Binding="{Binding FuoriSede}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Registro immersioni">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding RegistroImmersioniPeriodoTitolo}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding RegistroImmersioniStato}"
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="Il riepilogo resta visibile; il dettaglio righe e' consultabile come report nella sezione sotto."
                                           Foreground="#6A7B80"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Width="170">
                                    <TextBlock Text="Mese"
                                               Foreground="#50626A" />
                                    <ComboBox ItemsSource="{Binding ContabilitaMesiDisponibili}"
                                              SelectedItem="{Binding ContabilitaMeseSelezionato}"
                                              DisplayMemberPath="Descrizione" />
                                </StackPanel>

                                <StackPanel Width="110"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Anno"
                                               Foreground="#50626A" />
                                    <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                              SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        Content="Aggiorna"
                                        Command="{Binding ReloadRegistroImmersioniCommand}" />

                                <Button Margin="12,20,0,0"
                                        Content="Stampa registro"
                                        Command="{Binding PrintRegistroImmersioniMensileCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="8,20,0,0"
                                        Content="Stampa compatta"
                                        Command="{Binding PrintRegistroImmersioniMensileCompattoCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2"
                                 Columns="4">
                        <Border Margin="0,0,12,0"
                                Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Immersioni"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleImmersioni}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Righe operatore"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleRighe}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Operatori distinti"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleOperatori}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Ore totali"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleOreDisplay}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Riepilogo per categoria"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,10,0,0"
                                           Text="{Binding RegistroImmersioniCategorieStato}"
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />

                                <DataGrid Grid.Row="2"
                                          Margin="0,16,0,0"
                                          ItemsSource="{Binding RegistroImmersioniCategorieItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Categoria"
                                                            Width="*"
                                                            Binding="{Binding CategoriaRegistro}" />
                                        <DataGridTextColumn Header="Immersioni"
                                                            Width="90"
                                                            Binding="{Binding ImmersioniTotali}" />
                                        <DataGridTextColumn Header="Righe"
                                                            Width="80"
                                                            Binding="{Binding RigheOperatoreTotali}" />
                                        <DataGridTextColumn Header="Ore"
                                                            Width="75"
                                                            Binding="{Binding OreTotaliDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Report dettaglio registro"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#17313E" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Dettaglio per immersione e operatore. Usalo quando serve controllare o ricostruire il registro, non come vista principale."
                                               Foreground="#53646A"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                          Margin="0,18,0,0"
                                          ItemsSource="{Binding RegistroImmersioniItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data"
                                                            Width="75"
                                                            Binding="{Binding DataServizioDescrizione}" />
                                        <DataGridTextColumn Header="Ordine"
                                                            Width="85"
                                                            Binding="{Binding NumeroOrdineServizio}" />
                                        <DataGridTextColumn Header="Imm."
                                                            Width="50"
                                                            Binding="{Binding NumeroImmersione}" />
                                        <DataGridTextColumn Header="Localita"
                                                            Width="150"
                                                            Binding="{Binding Localita}" />
                                        <DataGridTextColumn Header="Categoria"
                                                            Width="160"
                                                            Binding="{Binding CategoriaRegistro}" />
                                        <DataGridTextColumn Header="Nominativo"
                                                            Width="180"
                                                            Binding="{Binding Nominativo}" />
                                        <DataGridTextColumn Header="App."
                                                            Width="75"
                                                            Binding="{Binding Apparato}" />
                                        <DataGridTextColumn Header="Prof."
                                                            Width="70"
                                                            Binding="{Binding ProfonditaDisplay}" />
                                        <DataGridTextColumn Header="Ore"
                                                            Width="55"
                                                            Binding="{Binding OreImmersioneDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Contabilita mensile">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding ContabilitaPeriodoTitolo}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ContabilitaStato}"
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ElaborazioneMensileStato}"
                                           Foreground="#6A7B80"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Width="170">
                                    <TextBlock Text="Mese"
                                               Foreground="#50626A" />
                                    <ComboBox ItemsSource="{Binding ContabilitaMesiDisponibili}"
                                              SelectedItem="{Binding ContabilitaMeseSelezionato}"
                                              DisplayMemberPath="Descrizione" />
                                </StackPanel>

                                <StackPanel Width="110"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Anno"
                                               Foreground="#50626A" />
                                    <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                              SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        Content="Aggiorna"
                                        Command="{Binding ReloadContabilitaCommand}" />

                                <Button Margin="12,20,0,0"
                                        Content="Esporta Excel"
                                        Command="{Binding ExportContabilitaExcelCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="8,20,0,0"
                                        Content="Esporta CSV"
                                        Command="{Binding ExportContabilitaCsvCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="8,20,0,0"
                                        Content="Stampa"
                                        Command="{Binding PrintContabilitaMensileCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Riepilogo esportazione"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ContabilitaSmzStato}"
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ContabilitaSmzItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"
                                                        Width="90"
                                                        Binding="{Binding DataServizioDescrizione}" />
                                    <DataGridTextColumn Header="Ordine"
                                                        Width="105"
                                                        Binding="{Binding NumeroOrdineServizio}" />
                                    <DataGridTextColumn Header="PerID"
                                                        Width="65"
                                                        Binding="{Binding PerId}" />
                                    <DataGridTextColumn Header="Qual."
                                                        Width="85"
                                                        Binding="{Binding QualificaDisplay}" />
                                    <DataGridTextColumn Header="Cognome e nome"
                                                        Width="210"
                                                        Binding="{Binding Nominativo}" />
                                    <DataGridTextColumn Header="Appar."
                                                        Width="80"
                                                        Binding="{Binding Apparato}" />
                                    <DataGridTextColumn Header="Prof."
                                                        Width="75"
                                                        Binding="{Binding FasciaProfondita}" />
                                    <DataGridTextColumn Header="ORE ORD"
                                                        Width="75"
                                                        Binding="{Binding OreOrdDisplay}" />
                                    <DataGridTextColumn Header="ORE ADD"
                                                        Width="75"
                                                        Binding="{Binding OreAddDisplay}" />
                                    <DataGridTextColumn Header="ORE SPER"
                                                        Width="80"
                                                        Binding="{Binding OreSperDisplay}" />
                                    <DataGridTextColumn Header="ORE C.I."
                                                        Width="75"
                                                        Binding="{Binding OreCiDisplay}" />
                                    <DataGridTextColumn Header="Importo"
                                                        Width="85"
                                                        Binding="{Binding ImportoDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Altri report">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding ReportPersonalePeriodoTitolo}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ReportPersonaleStato}"
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="Elenco mensile del personale impiegato: righe immersione, servizi senza immersione e supporti occasionali."
                                           Foreground="#6A7B80"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Width="170">
                                    <TextBlock Text="Mese"
                                               Foreground="#50626A" />
                                    <ComboBox ItemsSource="{Binding ContabilitaMesiDisponibili}"
                                              SelectedItem="{Binding ContabilitaMeseSelezionato}"
                                              DisplayMemberPath="Descrizione" />
                                </StackPanel>

                                <StackPanel Width="110"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Anno"
                                               Foreground="#50626A" />
                                    <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                              SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Width="220"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Nominativo / PerID"
                                               Foreground="#50626A" />
                                    <TextBox Text="{Binding ReportPersonaleFiltroNominativo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        Content="Aggiorna"
                                        Command="{Binding ReloadReportPersonaleCommand}" />

                                <Button Margin="8,20,0,0"
                                        Content="Pulisci"
                                        Command="{Binding ClearReportPersonaleFiltersCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2"
                                 Columns="4">
                        <Border Margin="0,0,12,0"
                                Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Righe"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotaleRighe}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Persone"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotalePersone}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Immersioni"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotaleImmersioni}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F4F8FB"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Ore immersione"
                                           Foreground="#6A7B80" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotaleOreDisplay}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="4"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Dettaglio personale"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#17313E" />

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ReportPersonaleItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"
                                                        Width="85"
                                                        Binding="{Binding DataServizioDescrizione}" />
                                    <DataGridTextColumn Header="Ordine"
                                                        Width="95"
                                                        Binding="{Binding NumeroOrdineServizio}" />
                                    <DataGridTextColumn Header="PerID"
                                                        Width="65"
                                                        Binding="{Binding PerIdDisplay}" />
                                    <DataGridTextColumn Header="Qual."
                                                        Width="80"
                                                        Binding="{Binding QualificaDisplay}" />
                                    <DataGridTextColumn Header="Nominativo"
                                                        Width="190"
                                                        Binding="{Binding Nominativo}" />
                                    <DataGridTextColumn Header="Tipo"
                                                        Width="90"
                                                        Binding="{Binding TipoRiga}" />
                                    <DataGridTextColumn Header="Gruppo / ruolo"
                                                        Width="180"
                                                        Binding="{Binding GruppoRuolo}" />
                                    <DataGridTextColumn Header="Localita"
                                                        Width="150"
                                                        Binding="{Binding Localita}" />
                                    <DataGridTextColumn Header="Scopo"
                                                        Width="220"
                                                        Binding="{Binding ScopoImmersione}" />
                                    <DataGridTextColumn Header="Imm."
                                                        Width="55"
                                                        Binding="{Binding NumeroImmersioneDisplay}" />
                                    <DataGridTextColumn Header="App."
                                                        Width="80"
                                                        Binding="{Binding Apparato}" />
                                    <DataGridTextColumn Header="Prof."
                                                        Width="70"
                                                        Binding="{Binding ProfonditaDisplay}" />
                                    <DataGridTextColumn Header="Ore"
                                                        Width="60"
                                                        Binding="{Binding OreImmersioneDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
