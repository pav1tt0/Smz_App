<UserControl x:Class="SMZ.Conta.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure"
             xmlns:controls="clr-namespace:SMZ.Conta.App.Controls">
    <!-- The workspace constrains width; content can grow vertically so filters
         and actions stay reachable on short displays. Tables scroll internally. -->
    <Grid Margin="6"
          MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Text="Stampe e report"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextBrush}" />

        <TabControl Grid.Row="2">
            <TabItem Header="Servizi">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="600" MaxColumns="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ServiziSalvatiStato}"
                                           MaxWidth="350"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Stampa servizio giornaliero"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </infra:AdaptiveGrid>

                            <WrapPanel Grid.Row="1"
                                       Margin="0,6,0,0"
                                       VerticalAlignment="Center">
                                <StackPanel Width="210">
                                    <TextBlock TextWrapping="Wrap" Text="Localita"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <TextBox Text="{Binding ServiziSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Cerca per localita" />
                                </StackPanel>

                                <StackPanel Width="120"
                                            Margin="12,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="N. servizio"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <TextBox Text="{Binding ServiziNumeroSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Numero servizio" />
                                </StackPanel>

                                <StackPanel Width="130"
                                            Margin="12,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="Data o mese"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <controls:DateInputPicker Text="{Binding ServiziDataSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                              AutoFormatText="False"
                                                              ShowMonthShortcut="True"
                                                              Width="120"
                                                              ToolTip="{Binding ServiziDataSearchToolTip}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        MinWidth="0"
                                        Padding="12,6"
                                        Content="Pulisci"
                                        Command="{Binding ClearServiziSearchCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{DynamicResource CardStyle}"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="600" MaxColumns="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Margin="12,0,0,0">
                                    <Button Content="Stampa servizio"
                                            Command="{Binding PrintServizioSelezionatoCommand}"
                                            MinWidth="0" Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="Apri servizio"
                                            Command="{Binding OpenServizioCommand}"
                                            MinWidth="0" Padding="12,6" Margin="0,0,8,0"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                    <Button Content="Esporta pacchetto"
                                            Command="{Binding ExportServizioPackageCommand}"
                                            MinWidth="0" Padding="12,6" Margin="0"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </WrapPanel>
                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Servizi trovati"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </infra:AdaptiveGrid>

                            <DataGrid Grid.Row="2"
                                      infra:MouseWheelScrollViewerBehavior.ForwardToParent="False"
                                      ItemsSource="{Binding ServiziSalvati}"
                                      SelectedItem="{Binding SelectedServizioSalvato}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      FontSize="14"
                                      ColumnWidth="Auto"
                                      ColumnHeaderHeight="NaN"
                                      RowHeight="NaN"
                                      MinRowHeight="40"
                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <Style x:Key="ServiceCellTextStyle" TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="8,6" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="MinHeight" Value="48" />
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Data"
                                                        Binding="{Binding DataServizio, StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Ordine"
                                                        Binding="{Binding NumeroOrdineServizio}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Orario"
                                                        Binding="{Binding OrarioServizio}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Localita"
                                                        Binding="{Binding LocalitaDescrizione}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Scopo"
                                                        Binding="{Binding ScopoDescrizione}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Mezzo"
                                                        Binding="{Binding UnitaNavaleDescrizione}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Presenti"
                                                        Binding="{Binding PresentiTotali}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Immersioni"
                                                        Binding="{Binding ImmersioniTotali}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Apparati"
                                                        Binding="{Binding ApparatiDescrizione}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Profondit&#224;&#10;massima"
                                                        Binding="{Binding ProfonditaMassimaDescrizione}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Ore&#10;immersione"
                                                        Binding="{Binding OreImmersioneTotaliDescrizione}" />
                                    <DataGridTextColumn ElementStyle="{StaticResource ServiceCellTextStyle}"
                                                        Header="Categorie"
                                                        Binding="{Binding CategorieOreDescrizione}" />
                                    <DataGridCheckBoxColumn Header="Fuori&#10;sede"
                                                            Binding="{Binding FuoriSede}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Registro immersioni">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}">
                        <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="500" MaxColumns="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding RegistroImmersioniPeriodoTitolo}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding RegistroImmersioniStato}"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="Il riepilogo resta visibile; il dettaglio righe e' consultabile come report nella sezione sotto."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <WrapPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Width="170">
                                    <TextBlock TextWrapping="Wrap" Text="Mese"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <ComboBox ItemsSource="{Binding ContabilitaMesiDisponibili}"
                                              SelectedItem="{Binding ContabilitaMeseSelezionato}"
                                              DisplayMemberPath="Descrizione" />
                                </StackPanel>

                                <StackPanel Width="110"
                                            Margin="12,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="Anno"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                              SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        Content="Aggiorna"
                                        Command="{Binding ReloadRegistroImmersioniCommand}" />

                                <Button Margin="12,20,0,0"
                                        Content="Stampa registro"
                                        Command="{Binding PrintRegistroImmersioniMensileCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="8,20,0,0"
                                        Content="Stampa compatta"
                                        Command="{Binding PrintRegistroImmersioniMensileCompattoCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </infra:AdaptiveGrid>
                    </Border>

                    <infra:AdaptiveUniformGrid Grid.Row="2"
                                 MaxColumns="4" MinItemWidth="180">
                        <Border Margin="0,0,12,0"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Immersioni"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleImmersioni}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Righe operatore"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleRighe}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Operatori distinti"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleOperatori}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Ore totali"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding RegistroImmersioniTotaleOreDisplay}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>
                    </infra:AdaptiveUniformGrid>

                    <infra:AdaptiveGrid Grid.Row="4" CollapseBelow="1000" MinItemWidth="500" MaxColumns="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock TextWrapping="Wrap" Text="Riepilogo per categoria"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,10,0,0"
                                           Text="{Binding RegistroImmersioniCategorieStato}"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <DataGrid Grid.Row="2"
                                          Margin="0,16,0,0"
                                          ItemsSource="{Binding RegistroImmersioniCategorieItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Categoria"
                                                            Width="*" MinWidth="200"
                                                            Binding="{Binding CategoriaRegistro}" />
                                        <DataGridTextColumn Header="Immersioni"
                                                            Width="90" MinWidth="90"
                                                            Binding="{Binding ImmersioniTotali}" />
                                        <DataGridTextColumn Header="Righe"
                                                            Width="80" MinWidth="80"
                                                            Binding="{Binding RigheOperatoreTotali}" />
                                        <DataGridTextColumn Header="Ore"
                                                            Width="75" MinWidth="75"
                                                            Binding="{Binding OreTotaliDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="Report dettaglio registro"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Dettaglio per immersione e operatore. Usalo quando serve controllare o ricostruire il registro, non come vista principale."
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                          Margin="0,18,0,0"
                                          ItemsSource="{Binding RegistroImmersioniItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data"
                                                            Width="75" MinWidth="75"
                                                            Binding="{Binding DataServizioDescrizione}" />
                                        <DataGridTextColumn Header="Ordine"
                                                            Width="85" MinWidth="85"
                                                            Binding="{Binding NumeroOrdineServizio}" />
                                        <DataGridTextColumn Header="Imm."
                                                            Width="50" MinWidth="50"
                                                            Binding="{Binding NumeroImmersione}" />
                                        <DataGridTextColumn Header="Localita"
                                                            Width="150" MinWidth="150"
                                                            Binding="{Binding Localita}" />
                                        <DataGridTextColumn Header="Categoria"
                                                            Width="160" MinWidth="160"
                                                            Binding="{Binding CategoriaRegistro}" />
                                        <DataGridTextColumn Header="Nominativo"
                                                            Width="180" MinWidth="180"
                                                            Binding="{Binding Nominativo}" />
                                        <DataGridTextColumn Header="App."
                                                            Width="75" MinWidth="75"
                                                            Binding="{Binding Apparato}" />
                                        <DataGridTextColumn Header="Prof."
                                                            Width="70" MinWidth="70"
                                                            Binding="{Binding ProfonditaDisplay}" />
                                        <DataGridTextColumn Header="Ore"
                                                            Width="55" MinWidth="55"
                                                            Binding="{Binding OreImmersioneDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </infra:AdaptiveGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Contabilità immersioni">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                <StackPanel Margin="8">
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding ContabilitaPeriodoTitolo}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding ContabilitaStato}"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ElaborazioneMensileStato}"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,14,0,0">
                                <StackPanel Width="170"
                                            Margin="0,0,12,0">
                                    <TextBlock TextWrapping="Wrap" Text="Mese"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <ComboBox ItemsSource="{Binding ContabilitaMesiDisponibili}"
                                              SelectedItem="{Binding ContabilitaMeseSelezionato}"
                                              DisplayMemberPath="Descrizione" />
                                </StackPanel>

                                <StackPanel Width="110"
                                            Margin="0,0,12,0">
                                    <TextBlock TextWrapping="Wrap" Text="Anno"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                              SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Margin="0,20,8,0"
                                        Content="Aggiorna"
                                        Command="{Binding ReloadContabilitaCommand}" />

                                <Button Margin="0,20,8,0"
                                        Content="Esporta Excel"
                                        Command="{Binding ExportContabilitaExcelCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="0,20,8,0"
                                        Content="Esporta CSV"
                                        Command="{Binding ExportContabilitaCsvCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />

                                <Button Margin="0,20,0,0"
                                        Content="Stampa"
                                        Command="{Binding PrintContabilitaMensileCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Riepilogo esportazione"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ContabilitaSmzStato}"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ContabilitaSmzItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"
                                                        Width="90" MinWidth="90"
                                                        Binding="{Binding DataServizioDescrizione}" />
                                    <DataGridTextColumn Header="Ordine"
                                                        Width="105" MinWidth="105"
                                                        Binding="{Binding NumeroOrdineServizio}" />
                                    <DataGridTextColumn Header="PerID"
                                                        Width="65" MinWidth="65"
                                                        Binding="{Binding PerId}" />
                                    <DataGridTextColumn Header="Qual."
                                                        Width="85" MinWidth="85"
                                                        Binding="{Binding QualificaDisplay}" />
                                    <DataGridTextColumn Header="Cognome e nome"
                                                        Width="210" MinWidth="210"
                                                        Binding="{Binding Nominativo}" />
                                    <DataGridTextColumn Header="Appar."
                                                        Width="80" MinWidth="80"
                                                        Binding="{Binding Apparato}" />
                                    <DataGridTextColumn Header="Prof."
                                                        Width="75" MinWidth="75"
                                                        Binding="{Binding FasciaProfondita}" />
                                    <DataGridTextColumn Header="ORE ORD"
                                                        Width="75" MinWidth="75"
                                                        Binding="{Binding OreOrdDisplay}" />
                                    <DataGridTextColumn Header="ORE ADD"
                                                        Width="75" MinWidth="75"
                                                        Binding="{Binding OreAddDisplay}" />
                                    <DataGridTextColumn Header="ORE SPER"
                                                        Width="80" MinWidth="80"
                                                        Binding="{Binding OreSperDisplay}" />
                                    <DataGridTextColumn Header="ORE C.I."
                                                        Width="75" MinWidth="75"
                                                        Binding="{Binding OreCiDisplay}" />
                                    <DataGridTextColumn Header="Importo"
                                                        Width="85" MinWidth="85"
                                                        Binding="{Binding ImportoDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="600" MaxColumns="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="2"
                                        Content="Esporta Word"
                                        Command="{Binding ExportAssistenzaSmzDocxCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <StackPanel Grid.Column="0">
                                    <TextBlock TextWrapping="Wrap" Text="Assistenza SMZ e sanitari"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding ContabilitaSupportoStato}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </infra:AdaptiveGrid>

                            <infra:AdaptiveGrid Grid.Row="2" CollapseBelow="800" MinItemWidth="400" MaxColumns="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DataGrid ItemsSource="{Binding ContabilitaSanitariItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Qual."
                                                            Width="80" MinWidth="80"
                                                            Binding="{Binding QualificaDisplay}" />
                                        <DataGridTextColumn Header="Sanitario"
                                                            Width="*" MinWidth="220"
                                                            Binding="{Binding Nominativo}" />
                                        <DataGridTextColumn Header="Trentesimi"
                                                            Width="90" MinWidth="90"
                                                            Binding="{Binding TrentesimiMaturati}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid Grid.Column="2"
                                          ItemsSource="{Binding ContabilitaSupportiItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Qual."
                                                            Width="80" MinWidth="80"
                                                            Binding="{Binding QualificaDisplay}" />
                                        <DataGridTextColumn Header="Assistenza"
                                                            Width="*" MinWidth="220"
                                                            Binding="{Binding Nominativo}" />
                                        <DataGridTextColumn Header="Trentesimi"
                                                            Width="90" MinWidth="90"
                                                            Binding="{Binding TrentesimiMaturati}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </infra:AdaptiveGrid>
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="600" MaxColumns="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="2"
                                        Content="Esporta Word"
                                        Command="{Binding ExportIndennitaFuoriSedeDocxCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <StackPanel Grid.Column="0">
                                    <TextBlock TextWrapping="Wrap" Text="Indennita fuori sede"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding IndennitaFuoriSedeStato}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </infra:AdaptiveGrid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding IndennitaFuoriSedeItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PerID"
                                                        Width="65" MinWidth="65"
                                                        Binding="{Binding PerId}" />
                                    <DataGridTextColumn Header="Qual."
                                                        Width="85" MinWidth="85"
                                                        Binding="{Binding QualificaDisplay}" />
                                    <DataGridTextColumn Header="Cognome e nome"
                                                        Width="220" MinWidth="220"
                                                        Binding="{Binding Nominativo}" />
                                    <DataGridTextColumn Header="Servizi svolti in data"
                                                        Width="*" MinWidth="300"
                                                        Binding="{Binding DateServizioDescrizione}" />
                                    <DataGridTextColumn Header="GG."
                                                        Width="70" MinWidth="70"
                                                        Binding="{Binding GiornateImpiego}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Altri report">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardStyle}">
                        <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="500" MaxColumns="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding ReportPersonalePeriodoTitolo}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ReportPersonaleStato}"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="Elenco mensile del personale impiegato: righe immersione, servizi senza immersione e supporti occasionali."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <WrapPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Width="170">
                                    <TextBlock TextWrapping="Wrap" Text="Mese"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <ComboBox ItemsSource="{Binding ReportPersonaleMesiDisponibili}"
                                              SelectedItem="{Binding ReportPersonaleMeseSelezionato}"
                                              DisplayMemberPath="Descrizione" />
                                </StackPanel>

                                <StackPanel Width="110"
                                            Margin="12,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="Anno"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                              SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Width="220"
                                            Margin="12,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="Nominativo / PerID"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <TextBox Text="{Binding ReportPersonaleFiltroNominativo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Margin="12,20,0,0"
                                        Content="Aggiorna"
                                        Command="{Binding ReloadReportPersonaleCommand}" />

                                <Button Margin="8,20,0,0"
                                        Content="Pulisci"
                                        Command="{Binding ClearReportPersonaleFiltersCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </infra:AdaptiveGrid>
                    </Border>

                    <infra:AdaptiveUniformGrid Grid.Row="2"
                                 MaxColumns="4" MinItemWidth="180">
                        <Border Margin="0,0,12,0"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Righe"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotaleRighe}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Persone"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotalePersone}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,12,0"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Immersioni"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotaleImmersioni}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Ore immersione"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding ReportPersonaleTotaleOreDisplay}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                        </Border>
                    </infra:AdaptiveUniformGrid>

                    <Border Grid.Row="4"
                            Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock TextWrapping="Wrap" Text="Dettaglio personale"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}" />

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ReportPersonaleItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"
                                                        Width="85" MinWidth="85"
                                                        Binding="{Binding DataServizioDescrizione}" />
                                    <DataGridTextColumn Header="Ordine"
                                                        Width="95" MinWidth="95"
                                                        Binding="{Binding NumeroOrdineServizio}" />
                                    <DataGridTextColumn Header="PerID"
                                                        Width="65" MinWidth="65"
                                                        Binding="{Binding PerIdDisplay}" />
                                    <DataGridTextColumn Header="Qual."
                                                        Width="80" MinWidth="80"
                                                        Binding="{Binding QualificaDisplay}" />
                                    <DataGridTextColumn Header="Nominativo"
                                                        Width="190" MinWidth="190"
                                                        Binding="{Binding Nominativo}" />
                                    <DataGridTextColumn Header="Tipo"
                                                        Width="90" MinWidth="90"
                                                        Binding="{Binding TipoRiga}" />
                                    <DataGridTextColumn Header="Gruppo / ruolo"
                                                        Width="180" MinWidth="180"
                                                        Binding="{Binding GruppoRuolo}" />
                                    <DataGridTextColumn Header="Localita"
                                                        Width="150" MinWidth="150"
                                                        Binding="{Binding Localita}" />
                                    <DataGridTextColumn Header="Scopo"
                                                        Width="220" MinWidth="220"
                                                        Binding="{Binding ScopoImmersione}" />
                                    <DataGridTextColumn Header="Imm."
                                                        Width="55" MinWidth="55"
                                                        Binding="{Binding NumeroImmersioneDisplay}" />
                                    <DataGridTextColumn Header="App."
                                                        Width="80" MinWidth="80"
                                                        Binding="{Binding Apparato}" />
                                    <DataGridTextColumn Header="Prof."
                                                        Width="70" MinWidth="70"
                                                        Binding="{Binding ProfonditaDisplay}" />
                                    <DataGridTextColumn Header="Ore"
                                                        Width="60" MinWidth="60"
                                                        Binding="{Binding OreImmersioneDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
