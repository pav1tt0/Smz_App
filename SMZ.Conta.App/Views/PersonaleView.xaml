<UserControl x:Class="SMZ.Conta.App.Views.PersonaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SMZ.Conta.App.Controls"
             xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="3"
                              Visibility="{Binding IsElencoPersonaleVisibile, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Cerca personale"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <TextBox Text="{Binding FiltroCognome, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Margin="0,8,0,0"
                                                Padding="8"
                                                Background="#F8FAFC"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding IsSearchSuggestionsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ListBox ItemsSource="{Binding SearchSuggestions}"
                                                     SelectedItem="{Binding SelectedSearchSuggestion}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     MaxHeight="140"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Abilitazione"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <ComboBox ItemsSource="{Binding FiltroAbilitazioni}"
                                                  SelectedItem="{Binding FiltroAbilitazione}"
                                                  DisplayMemberPath="Descrizione" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Visite entro"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <controls:DateInputPicker Text="{Binding FiltroVisiteEntro, UpdateSourceTrigger=PropertyChanged}"
                                                                  Width="150"
                                                                  ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Bottom">
                                        <Button Content="Cerca"
                                                Command="{Binding SearchCommand}" />
                                        <Button Content="Pulisci"
                                                Command="{Binding ClearFiltersCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Nuovo"
                                                Command="{Binding NewCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Elenco personale"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding DashboardDipendentiTotali, StringFormat={}{0} nominativi disponibili}"
                                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Apri scheda"
                                                Command="{Binding OpenSelectedPersonaleCommand}" />
                                    </DockPanel>

                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding PersonaleItems}"
                                             SelectedItem="{Binding SelectedPersonale}"
                                             MinHeight="520"
                                             infra:MouseWheelScrollViewerBehavior.ForwardToParent="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,10,10" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="300"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenSelectedPersonaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border Padding="12"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F7F9FB" />
                                                                <Setter Property="BorderBrush" Value="#DCE5EC" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="#EAF3F8" />
                                                                        <Setter Property="BorderBrush" Value="#5B84BD" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Text="{Binding NominativoConQualifica}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <Grid Grid.Row="1"
                                                                  Margin="0,6,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding CodiceFiscale}"
                                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Grid.Column="1"
                                                                        Margin="8,0,0,0"
                                                                        Padding="8,3"
                                                                        Background="#E2ECF3"
                                                                        CornerRadius="999">
                                                                    <TextBlock Text="{Binding StatoServizioSintesi}"
                                                                               Foreground="#24527B"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Visibility="Collapsed">
                            <Border Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Personale"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding DashboardDipendentiTotali, StringFormat={}{0} nominativi}"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Nuovo"
                                                Command="{Binding NewCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </DockPanel>

                                    <StackPanel Grid.Row="1"
                                                Margin="0,16,0,0">
                                        <TextBlock Text="Cerca"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <TextBox Text="{Binding FiltroCognome, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border Margin="0,8,0,0"
                                                Padding="8"
                                                Background="#F8FAFC"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Visibility="{Binding IsSearchSuggestionsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ListBox ItemsSource="{Binding SearchSuggestions}"
                                                     SelectedItem="{Binding SelectedSearchSuggestion}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     MaxHeight="120"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,12,0,0">
                                            <Button Content="Cerca"
                                                    Command="{Binding SearchCommand}" />
                                            <Button Content="Pulisci"
                                                    Command="{Binding ClearFiltersCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ListBox Grid.Row="2"
                                             Margin="0,14,0,0"
                                             ItemsSource="{Binding PersonaleItems}"
                                             SelectedItem="{Binding SelectedPersonale}"
                                             MinHeight="420"
                                             MaxHeight="620"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="False"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F7F9FB" />
                                                            <Setter Property="BorderBrush" Value="#DCE5EC" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Background" Value="#EAF3F8" />
                                                                    <Setter Property="BorderBrush" Value="#5B84BD" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="{Binding NominativoConQualifica}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <Grid Grid.Row="1"
                                                              Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CodiceFiscale}"
                                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    Padding="8,3"
                                                                    Background="#E2ECF3"
                                                                    CornerRadius="999">
                                                                <TextBlock Text="{Binding StatoServizioSintesi}"
                                                                           Foreground="#24527B"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Expander Grid.Row="3"
                                              Margin="0,12,0,0"
                                              Header="Filtri avanzati"
                                              Foreground="{DynamicResource AppTextBrush}"
                                              FontWeight="SemiBold">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Abilitazione o specialita"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="Normal" />
                                            <ComboBox ItemsSource="{Binding FiltroAbilitazioni}"
                                                      SelectedItem="{Binding FiltroAbilitazione}"
                                                      DisplayMemberPath="Descrizione" />

                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Visite in scadenza entro"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="Normal" />
                                            <controls:DateInputPicker Text="{Binding FiltroVisiteEntro, UpdateSourceTrigger=PropertyChanged}"
                                                                      Width="150"
                                                                      HorizontalAlignment="Left"
                                                                      ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />
                                        </StackPanel>
                                    </Expander>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Visibility="{Binding IsSchedaPersonaleVisibile, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Scheda anagrafica"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Torna elenco"
                                                Command="{Binding CloseSchedaPersonaleCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Nuovo"
                                                Command="{Binding NewCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                        <Button Content="Salva"
                                                Command="{Binding SaveCommand}" />
                                        <Button Content="Cessa da oggi"
                                                Command="{Binding DeleteCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Elimina definitivamente"
                                                Command="{Binding DeleteDefinitivoCommand}"
                                                Style="{DynamicResource DangerButtonStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Margin="0,18,0,0"
                                        Background="#173A57"
                                        CornerRadius="22"
                                        Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Riepilogo operativo"
                                                       Foreground="#CBDBE0"
                                                       FontSize="13" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SchedaRiepilogoTitolo}"
                                                       Foreground="#FFF8EE"
                                                       FontSize="22"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding SchedaRiepilogoPerId}"
                                                       Foreground="#D9E4E7" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding StatoServizioSchedaSintesi}"
                                                       Foreground="#D9E4E7" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#24527B"
                                                CornerRadius="18"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Abilitazioni principali"
                                                           Foreground="#CBDBE0"
                                                           FontSize="12" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding SchedaAbilitazioniPrincipali}"
                                                           Foreground="#FFF8EE"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Text="{Binding SchedaAbilitazioniPrincipaliFooter}"
                                                           Foreground="#CBDBE0"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4"
                                                Background="#F8FAFC"
                                                CornerRadius="18"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Prossima scadenza"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{Binding SchedaProssimaScadenza}"
                                                           Foreground="{DynamicResource AppTextBrush}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding SchedaProssimaScadenzaDettaglio}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="6"
                                                CornerRadius="18"
                                                Padding="14">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EEF2F4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SchedaHaScadute}" Value="True">
                                                            <Setter Property="Background" Value="#FBEAEA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SchedaScaduteTitolo}"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#53646A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SchedaHaScadute}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8B2E2E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{Binding SchedaScaduteHighlight}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#17313E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SchedaHaScadute}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8B2E2E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding SchedaScaduteDettaglio}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#52656B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SchedaHaScadute}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8B2E2E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Margin="0,18,0,0"
                                        Background="#F8FAFC"
                                        CornerRadius="18"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Date: usa valori come 18/03/2026. Le abilitazioni e le visite si inseriscono dal pannello guidato qui sotto, non piu scrivendo direttamente in griglia."
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="Per trasferimenti o cessazioni imposta lo stato di servizio e la data di fine servizio: lo storico resta valido, mentre i nuovi servizi useranno solo personale disponibile alla data del servizio."
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                    <TextBlock Margin="0,16,0,0"
                                               Text="Dati di servizio"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="PerID" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBox Text="{Binding PerIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsExistingPerson}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Qualifica" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <ComboBox ItemsSource="{Binding QualificheDisponibili}"
                                                      Text="{Binding Qualifica, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Decorrenza qualifica" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <controls:DateInputPicker Text="{Binding DataDecorrenzaQualifica, UpdateSourceTrigger=PropertyChanged}"
                                                                      Width="150"
                                                                      ToolTip="Data decorrenza della qualifica, usata per ordinare l'anzianita a parita di qualifica" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Profilo personale" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <ComboBox ItemsSource="{Binding ProfiliPersonaleDisponibili}"
                                                      SelectedItem="{Binding ProfiloPersonale}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="N. brevetto" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBox Text="{Binding NumeroBrevettoSmz, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="5" Margin="0,10,0,0">
                                            <TextBlock Text="Ruolo sanitario" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <ComboBox ItemsSource="{Binding RuoliSanitariDisponibili}"
                                                      SelectedItem="{Binding RuoloSanitario}"
                                                      IsEnabled="{Binding IsProfiloSanitario}" />
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfiloSanitario}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <TextBlock Text="Stato servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <ComboBox ItemsSource="{Binding StatiServizioPersonaleDisponibili}"
                                                      SelectedItem="{Binding StatoServizioPersonale}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding DataFineServizioLabel}" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <controls:DateInputPicker Text="{Binding DataFineServizio, UpdateSourceTrigger=PropertyChanged}"
                                                                      Width="150"
                                                                      ToolTip="Per trasferiti o cessati indica l'ultimo giorno di servizio" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,8,0,0"
                                               Text="Per il profilo sanitario il ruolo sanitario e obbligatorio; brevetto subacqueo e attagliamento restano facoltativi."
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,20,0,0"
                                               Text="Dati anagrafici"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Cognome" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding Cognome, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Nome" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Data di nascita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <controls:DateInputPicker Text="{Binding DataNascita, UpdateSourceTrigger=PropertyChanged}"
                                                                          Width="150"
                                                                          ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Luogo di nascita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding LuogoNascita, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Codice fiscale" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding CodiceFiscale, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="16" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Margin="0,20,0,0"
                                               Text="Contatti e residenza"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Telefono 1" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBox Text="{Binding Telefono1, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Telefono 2" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBox Text="{Binding Telefono2, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <TextBlock Text="Mail Polizia" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Right"
                                                        Margin="8,0,0,0"
                                                        Padding="10,8"
                                                        Background="#F1F6FB"
                                                        BorderBrush="#C9D5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <TextBlock Text="{Binding MailDominioFisso}"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBox Text="{Binding Mail1Utente, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Inserisci solo il nome utente istituzionale" />
                                            </DockPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                            <TextBlock Text="Mail personale" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBox Text="{Binding Mail2Utente, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inserisci l'indirizzo completo" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                            <TextBlock Text="Via" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBox Text="{Binding ViaResidenza, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="CAP" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding CapResidenza, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Citta" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding CittaResidenza, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                        </Border>
                        <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                            <TabControl Background="Transparent"
                                        BorderThickness="0"
                                        SelectedIndex="{Binding SchedaDettaglioTabIndex}">
                                <TabItem Header="Abilitazioni">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Background="#F3F6FA" CornerRadius="18" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Inserimento guidato abilitazione"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextBrush}" />

                                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="Tipo abilitazione" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <ComboBox ItemsSource="{Binding TipiAbilitazioneCatalogo}"
                                                                  SelectedItem="{Binding AbilitazioneTipoSelezionato}"
                                                                  DisplayMemberPath="EtichettaCompleta" />

                                                        <TextBlock Margin="0,10,0,0" Text="{Binding AbilitazioneLivelloEtichetta}" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <ComboBox ItemsSource="{Binding AbilitazioneLivelliSuggeriti}"
                                                                  Text="{Binding AbilitazioneLivello, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding AbilitazioneRichiedeLivello}"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="False"
                                                                  ToolTip="Per la patente di guida seleziona un certificato da 1 a 5" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Data conseguimento" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <controls:DateInputPicker Text="{Binding AbilitazioneDataConseguimento, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Width="150"
                                                                                  ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />

                                                        <TextBlock Margin="0,10,0,0" Text="Data scadenza" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <controls:DateInputPicker Text="{Binding AbilitazioneDataScadenza, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Width="150"
                                                                                  ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa"
                                                                                  IsEnabled="{Binding AbilitazioneRichiedeScadenza}" />

                                                        <TextBlock Margin="0,10,0,0" Text="Note" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Text="{Binding AbilitazioneNote, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding AbilitazioneIndicazioni}"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                                                        <Button Content="{Binding AzioneAbilitazioneLabel}"
                                                                Command="{Binding SaveAbilitazioneCommand}" />
                                                        <Button Content="Pulisci editor"
                                                                Command="{Binding ClearAbilitazioneEditorCommand}"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                        <Button Content="Rimuovi selezionata"
                                                                Command="{Binding RemoveAbilitazioneCommand}"
                                                                Style="{DynamicResource DangerButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataGrid Grid.Row="2"
                                                  ItemsSource="{Binding Abilitazioni}"
                                                  SelectedItem="{Binding SelectedAbilitazione}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  MinHeight="260"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tipo"
                                                                    Width="230"
                                                                    Binding="{Binding TipoDescrizione}" />
                                                <DataGridTextColumn Header="Categoria"
                                                                    Width="120"
                                                                    Binding="{Binding Categoria}" />
                                                <DataGridTextColumn Header="Livello"
                                                                    Width="120"
                                                                    Binding="{Binding Livello}" />
                                                <DataGridTextColumn Header="Conseguimento"
                                                                    Width="120"
                                                                    Binding="{Binding DataConseguimento}" />
                                                <DataGridTextColumn Header="Scadenza"
                                                                    Width="120"
                                                                    Binding="{Binding DataScadenza}" />
                                                <DataGridTextColumn Header="Note"
                                                                    Width="*"
                                                                    Binding="{Binding Note}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Visite mediche">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Background="#F3F6FA" CornerRadius="18" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Visite mediche obbligatorie"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextBrush}" />

                                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="Tipo visita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <ComboBox ItemsSource="{Binding TipiVisitaMedicaCatalogo}"
                                                                  SelectedItem="{Binding VisitaTipoSelezionato}"
                                                                  DisplayMemberPath="Descrizione" />

                                                        <TextBlock Margin="0,10,0,0" Text="Data ultima visita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <controls:DateInputPicker Text="{Binding VisitaDataUltimaVisita, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Width="150"
                                                                                  ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />

                                                        <TextBlock Margin="0,10,0,0" Text="Esito" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Text="{Binding VisitaEsito, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding RegoleVisiteTitolo}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Text="{Binding RegoleVisiteDescrizione}"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   TextWrapping="Wrap" />

                                                        <TextBlock Margin="0,12,0,0" Text="Scadenza calcolata" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Text="{Binding VisitaScadenzaCalcolata, Mode=OneWay}"
                                                                 Style="{DynamicResource DateTextBoxStyle}"
                                                                 IsReadOnly="True"
                                                                 IsReadOnlyCaretVisible="False"
                                                                 Background="#F6F8F6" />

                                                        <TextBlock Margin="0,10,0,0" Text="Note" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Text="{Binding VisitaNote, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding VisitaIndicazioni}"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                                                        <Button Content="{Binding AzioneVisitaLabel}"
                                                                Command="{Binding SaveVisitaCommand}" />
                                                        <Button Content="Ricarica visita"
                                                                Command="{Binding ClearVisitaEditorCommand}"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataGrid Grid.Row="2"
                                                  ItemsSource="{Binding VisiteMediche}"
                                                  SelectedItem="{Binding SelectedVisita}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  MinHeight="260"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tipo visita"
                                                                    Width="280"
                                                                    Binding="{Binding TipoVisita}" />
                                                <DataGridTextColumn Header="Ultima visita"
                                                                    Width="130"
                                                                    Binding="{Binding DataUltimaVisita}" />
                                                <DataGridTextColumn Header="Scadenza"
                                                                    Width="150"
                                                                    Binding="{Binding DataScadenza}" />
                                                <DataGridTextColumn Header="Esito"
                                                                    Width="150"
                                                                    Binding="{Binding Esito}" />
                                                <DataGridTextColumn Header="Note"
                                                                    Width="*"
                                                                    Binding="{Binding Note}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Attagliamento">
                                    <ScrollViewer Margin="8"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <Border Background="#F8FAFC"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="22">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.35*" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="Scheda misure"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Text="{Binding AttagliamentoIndicazioni}"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   TextWrapping="Wrap" />

                                                        <ItemsControl Margin="0,24,0,0"
                                                                      ItemsSource="{Binding AttagliamentoSchedaItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,18">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="260" />
                                                                            <ColumnDefinition Width="56" />
                                                                            <ColumnDefinition Width="130" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="17"
                                                                                   Foreground="#0F2430"
                                                                                   TextWrapping="Wrap">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding StringFormat="{}{0} - {1}">
                                                                                    <Binding Path="NumeroScheda" />
                                                                                    <Binding Path="EtichettaScheda" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>

                                                                        <TextBlock Grid.Column="1"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Right"
                                                                                   FontSize="17"
                                                                                   Foreground="#0F2430"
                                                                                   Text="{Binding UnitaScheda}" />

                                                                        <TextBox Grid.Column="2"
                                                                                 Margin="10,0,0,0"
                                                                                 Padding="10,6"
                                                                                 FontSize="16"
                                                                                 Background="White"
                                                                                 BorderBrush="#B7C7D1"
                                                                                 BorderThickness="1"
                                                                                 HorizontalContentAlignment="Left"
                                                                                 VerticalContentAlignment="Center"
                                                                                 Text="{Binding TagliaMisura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Background="White"
                                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top">
                                                        <Image Source="/Assets/Figura_taglie.png"
                                                               MaxWidth="300"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Margin="0,16,0,0"
                                                    Padding="16"
                                                    Background="#F3F6FA"
                                                    CornerRadius="16"
                                                    Visibility="{Binding HasAttagliamentoAggiuntivo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Misure aggiuntive gia presenti"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextBrush}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="Le voci non comprese nella scheda principale restano salvate e visibili qui."
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               TextWrapping="Wrap" />

                                                    <DataGrid Margin="0,12,0,0"
                                                              ItemsSource="{Binding AttagliamentoAggiuntivoItems}"
                                                              AutoGenerateColumns="False"
                                                              CanUserAddRows="False"
                                                              IsReadOnly="False"
                                                              MinHeight="120"
                                                              HeadersVisibility="Column"
                                                              RowHeaderWidth="0">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Voce"
                                                                                Width="220"
                                                                                Binding="{Binding Voce, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Header="Misura"
                                                                                Width="140"
                                                                                Binding="{Binding TagliaMisura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Header="Note"
                                                                                Width="*"
                                                                                Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                    </Grid>
</UserControl>
