<UserControl x:Class="SMZ.Conta.App.Views.ContabilitaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding ContabilitaPeriodoTitolo}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#17313E" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Modulo contabile operativo: riepilogo SMZ immersioni, piu giornate utili e trentesimi per sanitari e Assistenza SMZ."
                                               Foreground="#53646A"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding ElaborazioneMensileStato}"
                                               Foreground="#4F6C84"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <StackPanel Width="170">
                                        <TextBlock Text="Mese"
                                                   Foreground="#50626A" />
                                        <ComboBox ItemsSource="{Binding ContabilitaMesiDisponibili}"
                                                  SelectedItem="{Binding ContabilitaMeseSelezionato}"
                                                  DisplayMemberPath="Descrizione" />
                                    </StackPanel>

                                    <StackPanel Width="110"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Anno"
                                                   Foreground="#50626A" />
                                        <ComboBox ItemsSource="{Binding ContabilitaAnniDisponibili}"
                                                  SelectedItem="{Binding ContabilitaAnnoSelezionato, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Button Margin="12,20,0,0"
                                            Content="Aggiorna"
                                            Command="{Binding ReloadContabilitaCommand}" />

                                    <Button Margin="12,20,0,0"
                                            Content="{Binding SalvaElaborazioneMensileLabel}"
                                            Command="{Binding SaveElaborazioneMensileCommand}"
                                            Style="{DynamicResource AccentButtonStyle}" />

                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Contabilita SMZ immersioni"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17313E" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding ContabilitaSmzStato}"
                                                   Foreground="#53646A"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Grid.Row="1"
                                           Margin="0,14,0,0"
                                           Text="Le righe sono separate per data e ordine di servizio, cosi puoi risalire subito all'origine operativa della contabilita."
                                           Foreground="#6A7B80"
                                           TextWrapping="Wrap" />

                                <WrapPanel Grid.Row="2"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Center">
                                    <StackPanel Width="145"
                                                Margin="0,0,10,8">
                                        <TextBlock Text="Data"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#53646A" />
                                        <ComboBox Margin="0,4,0,0"
                                                  ItemsSource="{Binding ContabilitaSmzDateDisponibili}"
                                                  SelectedItem="{Binding ContabilitaSmzFiltroData, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Width="150"
                                                Margin="0,0,10,8">
                                        <TextBlock Text="N. servizio"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#53646A" />
                                        <ComboBox Margin="0,4,0,0"
                                                  ItemsSource="{Binding ContabilitaSmzNumeriServizioDisponibili}"
                                                  SelectedItem="{Binding ContabilitaSmzFiltroNumeroServizio, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Width="230"
                                                Margin="0,0,10,8">
                                        <TextBlock Text="Nominativo"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#53646A" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding ContabilitaSmzFiltroNominativo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Width="150"
                                                Margin="0,0,10,8">
                                        <TextBlock Text="Apparato"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#53646A" />
                                        <ComboBox Margin="0,4,0,0"
                                                  ItemsSource="{Binding ContabilitaSmzApparatiDisponibili}"
                                                  SelectedItem="{Binding ContabilitaSmzFiltroApparato, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Button Margin="0,20,0,8"
                                            Padding="10,4"
                                            Content="Pulisci filtri"
                                            Command="{Binding ClearContabilitaSmzFiltersCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </WrapPanel>

                                <DataGrid Grid.Row="3"
                                          Margin="0,16,0,0"
                                          ItemsSource="{Binding ContabilitaSmzItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data"
                                                            Width="95"
                                                            Binding="{Binding DataServizioDescrizione}" />
                                        <DataGridTextColumn Header="Ordine"
                                                            Width="120"
                                                            Binding="{Binding NumeroOrdineServizio}" />
                                        <DataGridTextColumn Header="PerID"
                                                            Width="80"
                                                            Binding="{Binding PerId}" />
                                        <DataGridTextColumn Header="Qual."
                                                            Width="110"
                                                            Binding="{Binding QualificaDisplay}" />
                                        <DataGridTextColumn Header="Cognome e nome"
                                                            Width="220"
                                                            Binding="{Binding Nominativo}" />
                                        <DataGridTextColumn Header="Appar."
                                                            Width="95"
                                                            Binding="{Binding Apparato}" />
                                        <DataGridTextColumn Header="Prof."
                                                            Width="80"
                                                            Binding="{Binding FasciaProfondita}" />
                                        <DataGridTextColumn Header="Tariffa"
                                                            Width="75"
                                                            Binding="{Binding TariffaDisplay}" />
                                        <DataGridTextColumn Header="ORE ORD"
                                                            Width="80"
                                                            Binding="{Binding OreOrdDisplay}" />
                                        <DataGridTextColumn Header="ORE ADD"
                                                            Width="80"
                                                            Binding="{Binding OreAddDisplay}" />
                                        <DataGridTextColumn Header="ORE SPER"
                                                            Width="85"
                                                            Binding="{Binding OreSperDisplay}" />
                                        <DataGridTextColumn Header="ORE C.I."
                                                            Width="80"
                                                            Binding="{Binding OreCiDisplay}" />
                                        <DataGridTextColumn Header="Importo"
                                                            Width="90"
                                                            Binding="{Binding ImportoDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Sanitari impiegati"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#17313E" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,10,0,0"
                                               Text="{Binding ContabilitaSanitariStato}"
                                               Foreground="#53646A"
                                               TextWrapping="Wrap" />

                                    <DataGrid Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding ContabilitaSanitariItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PerID"
                                                                Width="80"
                                                                Binding="{Binding PerId}" />
                                            <DataGridTextColumn Header="Nominativo"
                                                                Width="220"
                                                                Binding="{Binding Nominativo}" />
                                            <DataGridTextColumn Header="Qualifica / ruolo"
                                                                Width="200"
                                                                Binding="{Binding QualificaConRuolo}" />
                                            <DataGridTextColumn Header="Giornate"
                                                                Width="90"
                                                                Binding="{Binding GiornateImpiego}" />
                                            <DataGridTextColumn Header="Trentesimi"
                                                                Width="90"
                                                                Binding="{Binding TrentesimiMaturati}" />
                                            <DataGridTextColumn Header="Ultimo servizio"
                                                                Width="120"
                                                                Binding="{Binding UltimaDataServizioDescrizione}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Assistenza SMZ"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#17313E" />
                                    <StackPanel Grid.Row="1"
                                                Margin="0,10,0,0">
                                        <TextBlock Text="{Binding ContabilitaSupportoStato}"
                                                   Foreground="#53646A"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Aggregazione per nominativo: conviene usare sempre la stessa scrittura per avere conteggi coerenti."
                                                   Foreground="#6A7B80"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <DataGrid Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding ContabilitaSupportiItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nominativo"
                                                                Width="220"
                                                                Binding="{Binding Nominativo}" />
                                            <DataGridTextColumn Header="Qualifica / ruolo"
                                                                Width="200"
                                                                Binding="{Binding QualificaConRuolo}" />
                                            <DataGridTextColumn Header="Giornate"
                                                                Width="90"
                                                                Binding="{Binding GiornateImpiego}" />
                                            <DataGridTextColumn Header="Trentesimi"
                                                                Width="90"
                                                                Binding="{Binding TrentesimiMaturati}" />
                                            <DataGridTextColumn Header="Ultimo servizio"
                                                                Width="120"
                                                                Binding="{Binding UltimaDataServizioDescrizione}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
</UserControl>
