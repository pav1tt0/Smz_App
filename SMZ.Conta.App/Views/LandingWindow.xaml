<Window x:Class="SMZ.Conta.App.Views.LandingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SMZ.Conta.App.Views"
        Title="SMZ La Spezia"
        Icon="/SMZ.App;component/Assets/logo_smz.ico"
        Width="1660" Height="960"
        MinWidth="1100" MinHeight="700"
        WindowState="Maximized"
        Background="#071528"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <ImageBrush x:Key="HomePhotoBrush"
                    ImageSource="/SMZ.App;component/Assets/smz.jpg"
                    Stretch="UniformToFill" />
        <LinearGradientBrush x:Key="WelcomeScreenOverlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8071528" Offset="0" />
            <GradientStop Color="#96092446" Offset="0.48" />
            <GradientStop Color="#C8071528" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#0E5AA7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0E5AA7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#E9F0F7" />
            <Setter Property="BorderBrush" Value="#CCD9E6" />
            <Setter Property="Foreground" Value="#0D1B3D" />
        </Style>
        <Style x:Key="WelcomeEnterButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#0E5AA7" />
            <Setter Property="BorderBrush" Value="#5CA8F2" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="24,15" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="WelcomeMetaTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2EEF9" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="WelcomeAudioButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#163A62" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#416C98" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWelcomeAudioEnabled}" Value="False">
                    <Setter Property="Background" Value="#1F2B3D" />
                    <Setter Property="Foreground" Value="#AEBFD1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WelcomeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource WelcomeAudioButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="21" />
        </Style>
        <Style x:Key="WelcomeBubbleStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#22D7F4FF" />
            <Setter Property="Stroke" Value="#80E8FAFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <views:WelcomeView />
</Window>
