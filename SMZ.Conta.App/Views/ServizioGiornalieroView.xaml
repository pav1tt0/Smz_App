<UserControl x:Class="SMZ.Conta.App.Views.ServizioGiornalieroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SMZ.Conta.App.Controls"
             xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="ServizioWheelDataGridStyle" TargetType="DataGrid">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>
        <Style x:Key="ServizioWheelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>
        <Style x:Key="ImmersionTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#9BC2DA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>

                    <Grid Margin="6">
                        <Grid Visibility="{Binding IsElencoServiziVisibile, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Servizi giornalieri"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ServiziSalvatiStato}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="3">
                                        <TextBlock Text="Ricerca servizi"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                         <Grid Margin="0,6,0,0">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="2*" />
                                                 <ColumnDefinition Width="12" />
                                                 <ColumnDefinition Width="130" />
                                                 <ColumnDefinition Width="12" />
                                                 <ColumnDefinition Width="150" />
                                                 <ColumnDefinition Width="12" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Localita"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontSize="12" />
                                             <TextBlock Grid.Column="2"
                                                        Text="N. servizio"
                                                        Foreground="{DynamicResource AppMutedTextBrush}"
                                                        FontSize="12" />
                                             <TextBlock Grid.Column="4"
                                                        Text="Data o mese"
                                                        Foreground="{DynamicResource AppMutedTextBrush}"
                                                        FontSize="12" />

                                            <TextBox Grid.Row="2"
                                                     Text="{Binding ServiziSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Cerca per localita" />
                                             <TextBox Grid.Row="2"
                                                      Grid.Column="2"
                                                      Text="{Binding ServiziNumeroSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Numero servizio" />
                                             <controls:DateInputPicker Grid.Row="2"
                                                                       Grid.Column="4"
                                                                       Text="{Binding ServiziDataSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                       AutoFormatText="False"
                                                                       ShowMonthShortcut="True"
                                                                       Width="145"
                                                                       ToolTip="{Binding ServiziDataSearchToolTip}" />
                                             <Button Grid.Row="2"
                                                     Grid.Column="6"
                                                     Content="Pulisci"
                                                     Command="{Binding ClearServiziSearchCommand}"
                                                     Style="{DynamicResource SecondaryButtonStyle}"
                                                     MinWidth="112"
                                                     Width="112"
                                                     Height="42"
                                                     Margin="0" />
                                        </Grid>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom">
                                        <Button Content="Nuovo"
                                                Command="{Binding NewServizioCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                        <Button Content="Duplica"
                                                Command="{Binding DuplicateServizioCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Elimina"
                                                Command="{Binding DeleteServizioCommand}"
                                                Style="{DynamicResource DangerButtonStyle}" />
                                        <Button Content="Importa"
                                                Command="{Binding ImportServizioPackageCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Elenco servizi compilati"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Sono visibili i servizi recenti; usa la ricerca per trovare quelli piu vecchi."
                                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding ServiziSalvati}"
                                             SelectedItem="{Binding SelectedServizioSalvato}"
                                             MaxHeight="430"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,3"
                                                        Padding="6"
                                                        Background="#F8FAFC"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <Border.ToolTip>
                                                        <ToolTip Placement="Mouse"
                                                                 MaxWidth="420">
                                                            <Border Padding="14"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="#C8D6DF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DataServizio, StringFormat=Servizio del {0:dd/MM/yyyy}}"
                                                                               FontSize="16"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AppTextBrush}" />
                                                                    <TextBlock Margin="0,8,0,0"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap">
                                                                        <Run Text="Ordine: " />
                                                                        <Run Text="{Binding NumeroOrdineServizio}" />
                                                                        <Run Text=" - Orario: " />
                                                                        <Run Text="{Binding OrarioServizio}" />
                                                                    </TextBlock>
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap">
                                                                        <Run Text="Tipo: " />
                                                                        <Run Text="{Binding TipoServizio}" />
                                                                    </TextBlock>
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding LocalitaDescrizione, StringFormat=Localita: {0}}"
                                                                               Foreground="{DynamicResource AppTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding ScopoDescrizione, StringFormat=Scopo: {0}}"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding UnitaNavaleDescrizione, StringFormat=Mezzo: {0}}"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               Foreground="{DynamicResource AppTextBrush}"
                                                                               FontWeight="SemiBold">
                                                                        <Run Text="Presenti " />
                                                                        <Run Text="{Binding PresentiTotali}" />
                                                                        <Run Text=" - Immersioni " />
                                                                        <Run Text="{Binding ImmersioniTotali}" />
                                                                    </TextBlock>
                                                                    <TextBlock Margin="0,7,0,0"
                                                                               Text="{Binding DettaglioImmersioniDescrizione}"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </ToolTip>
                                                    </Border.ToolTip>

                                                    <Grid MinHeight="50">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="168" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="102" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="{Binding DataServizio, StringFormat={}{0:dd/MM/yyyy}}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TipoServizio}"
                                                                   Foreground="#4F73A5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="Ord. " />
                                                            <Run Text="{Binding NumeroOrdineServizio}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding OrarioServizio}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding LocalitaDescrizione}"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}">
                                                            <Run Text="Presenti " />
                                                            <Run Text="{Binding PresentiTotali}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="5"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   Text="{Binding ImmersioniTotali, StringFormat=Immersioni: {0}}" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="2"
                                                                   Grid.ColumnSpan="4"
                                                                   Margin="0,4,8,0"
                                                                   Text="{Binding DettaglioImmersioniDescrizione}"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DettaglioImmersioniDescrizione}" />
                                                        <Button Grid.Column="6"
                                                                Grid.RowSpan="2"
                                                                Content="Apri"
                                                                Width="96"
                                                                MinWidth="0"
                                                                Height="26"
                                                                Padding="8,1"
                                                                Margin="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.OpenServizioFromListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsSchedaServizioVisibile, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <DockPanel LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <Button Content="Torna elenco"
                                                Command="{Binding CloseSchedaServizioCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Salva"
                                                Command="{Binding SaveServizioCommand}" />
                                        <Button Content="Stampa servizio"
                                                Command="{Binding PrintServizioCommand}"
                                                Visibility="{Binding IsServizioApertoDaReport, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                    </WrapPanel>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ServizioEditorTitolo}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ServizioBozzaStato}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                            <ScrollViewer x:Name="ServizioEditorScrollViewer"
                                          infra:MouseWheelScrollViewerBehavior.ForwardToParent="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource ServizioWheelDataGridStyle}" />
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ServizioWheelTextBoxStyle}" />
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
                                    </Style>
                                    <Style TargetType="controls:DateInputPicker">
                                        <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="{Binding ServizioEditorSottotitolo}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <Border Margin="0,16,0,0"
                                            Background="#F8FAFC"
                                            CornerRadius="18"
                                            Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Data servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <controls:DateInputPicker Text="{Binding ServizioData, UpdateSourceTrigger=PropertyChanged}"
                                                                          Width="150"
                                                                          ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="N. ordine servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding ServizioNumeroOrdine, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="40" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Orario servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Width="150"
                                                              HorizontalAlignment="Left"
                                                              ItemsSource="{Binding OrariServizioFissiDisponibili}"
                                                              SelectedItem="{Binding ServizioOrarioFissoSelezionato}"
                                                              ToolTip="Seleziona uno degli orari fissi del servizio" />

                                                    <StackPanel Grid.Column="2">
                                                        <CheckBox HorizontalAlignment="Left"
                                                                  IsChecked="{Binding ServizioOrarioDerogaAttiva}"
                                                                  Content="Orario in deroga" />
                                                        <StackPanel Margin="0,8,0,0"
                                                                    Orientation="Horizontal"
                                                                    Visibility="{Binding ServizioOrarioDerogaAttiva, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel>
                                                                <TextBlock Text="Inizio"
                                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                                           FontSize="11" />
                                                                <TextBox Width="82"
                                                                         Text="{Binding ServizioOrarioDerogaInizio, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="5"
                                                                         ToolTip="Esempio: 07:30"
                                                                         infra:TimeInputBehavior.AutoFormat="True" />
                                                            </StackPanel>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="Fine"
                                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                                           FontSize="11" />
                                                                <TextBox Width="82"
                                                                         Text="{Binding ServizioOrarioDerogaFine, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="5"
                                                                         ToolTip="Esempio: 14:15"
                                                                         infra:TimeInputBehavior.AutoFormat="True" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Margin="0,10,0,0"
                                                        Padding="12"
                                                        Background="#EBF2F7"
                                                        BorderBrush="#D3DFE8"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                    <StackPanel>
                                                        <CheckBox IsChecked="{Binding ServizioStraordinarioAttivo}"
                                                                  Content="Lavoro straordinario" />
                                                        <StackPanel Margin="0,10,0,0"
                                                                    Orientation="Horizontal"
                                                                    Visibility="{Binding ServizioStraordinarioAttivo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel>
                                                                <TextBlock Text="Inizio"
                                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                                           FontSize="11" />
                                                                <TextBox Width="82"
                                                                         Text="{Binding ServizioStraordinarioInizio, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="5"
                                                                         ToolTip="Esempio: 18:30"
                                                                         infra:TimeInputBehavior.AutoFormat="True" />
                                                            </StackPanel>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="Fine"
                                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                                           FontSize="11" />
                                                                <TextBox Width="82"
                                                                         Text="{Binding ServizioStraordinarioFine, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="5"
                                                                         ToolTip="Esempio: 21:15"
                                                                         infra:TimeInputBehavior.AutoFormat="True" />
                                                            </StackPanel>
                                                            <Border Margin="14,18,0,0"
                                                                    Padding="12,8"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="#D3DFE8"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <TextBlock Text="{Binding ServizioStraordinarioOreDisplay}"
                                                                           Foreground="{DynamicResource AppTextBrush}"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="Tipo servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <ComboBox ItemsSource="{Binding TipiServizioDisponibili}"
                                                          SelectedItem="{Binding ServizioTipoSelezionato}" />
                                            </StackPanel>

                                            <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Localita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <ComboBox Width="300"
                                                              HorizontalAlignment="Left"
                                                              ItemsSource="{Binding LocalitaOperativeServizioCatalogo}"
                                                              SelectedItem="{Binding ServizioLocalitaSelezionata}"
                                                              DisplayMemberPath="Descrizione" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Unita navale" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <ComboBox Width="220"
                                                              HorizontalAlignment="Left"
                                                              ItemsSource="{Binding UnitaNavaliCatalogo}"
                                                              SelectedItem="{Binding ServizioUnitaNavaleSelezionata}"
                                                              DisplayMemberPath="Descrizione" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                <TextBlock Text="Indennita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <CheckBox Margin="0,10,0,0"
                                                          IsChecked="{Binding ServizioFuoriSede}"
                                                          Content="Indennita fuori sede" />
                                                <CheckBox Margin="0,8,0,0"
                                                          IsChecked="{Binding ServizioIndennitaOrdinePubblico}"
                                                          Content="Indennita ordine pubblico" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Text="Le due indennita non sono compatibili tra loro."
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="Scopo immersione" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <ComboBox ItemsSource="{Binding ScopiImmersioneCatalogo}"
                                                              SelectedItem="{Binding ServizioScopoSelezionato}"
                                                              DisplayMemberPath="Descrizione" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Responsabile servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <ComboBox ItemsSource="{Binding OperatoriServizioPresentiDisponibili}"
                                                              SelectedItem="{Binding ServizioResponsabileSelezionato}"
                                                              DisplayMemberPath="NominativoConQualifica"
                                                              ToolTip="Proposto automaticamente: il piu alto in grado tra i presenti. Modificabile se necessario." />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="4" Grid.ColumnSpan="5" Margin="0,10,0,0">
                                                <TextBlock Text="Attivita svolta" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding ServizioAttivitaSvolta, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{DynamicResource ServizioWheelTextBoxStyle}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         MinHeight="64" />
                                                <TextBlock Margin="0,10,0,0" Text="Note servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBox Text="{Binding ServizioNote, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{DynamicResource ServizioWheelTextBoxStyle}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         MinHeight="54" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Personale impiegato"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Seleziona il personale interno del servizio. I contatori ora considerano solo le righe effettivamente compilate."
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <DataGrid Margin="0,16,0,0"
                                              Style="{DynamicResource ServizioWheelDataGridStyle}"
                                              ItemsSource="{Binding ServizioPartecipantiBozza}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              Sorting="ServizioPartecipantiDataGrid_Sorting"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Qualifica"
                                                                Width="120"
                                                                Binding="{Binding QualificaDisplay}" />
                                            <DataGridTextColumn Header="Cognome e nome"
                                                                Width="220"
                                                                Binding="{Binding Nominativo}" />
                                            <DataGridTemplateColumn Header="Presente"
                                                                    Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Focusable="False"
                                                                  IsChecked="{Binding Presente, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Gruppo operativo" Width="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding GruppoOperativo.Descrizione}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.GruppiOperativiCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding GruppoOperativo, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="Descrizione" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Ruolo" Width="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RuoloOperativo.Descrizione}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.RuoliOperativiCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding RuoloOperativo, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="Descrizione" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Contatti"
                                                                Width="220"
                                                                Binding="{Binding Contatti}" />
                                            <DataGridTextColumn Header="Note"
                                                                Width="*"
                                                                Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DockPanel Margin="0,24,0,0" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="Operatori sub altri reparti"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal">
                                            <Button Content="Aggiungi operatore"
                                                    Command="{Binding AddOperatoreSubEsternoCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                            <Button Content="Rimuovi selezionato"
                                                    Command="{Binding RemoveOperatoreSubEsternoCommand}"
                                                    Style="{DynamicResource DangerButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Operatori SMZ o OSSALC di altri reparti inseriti solo per questo servizio. Una volta compilati compaiono tra i presenti immersione."
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <DataGrid Margin="0,16,0,0"
                                              Style="{DynamicResource ServizioWheelDataGridStyle}"
                                              ItemsSource="{Binding ServizioOperatoriSubEsterniBozza}"
                                              SelectedItem="{Binding SelectedOperatoreSubEsterno}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PerID"
                                                                Width="100"
                                                                Binding="{Binding PerId, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Header="Qualifica"
                                                                    Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding QualificaDisplay}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.QualificheDisponibili, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Text="{Binding Qualifica, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="True" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Nominativo"
                                                                Width="220"
                                                                Binding="{Binding Nominativo, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Reparto"
                                                                Width="180"
                                                                Binding="{Binding Reparto, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Header="Gruppo"
                                                                    Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding GruppoOperativo.Codice}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.GruppiOperativiCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding GruppoOperativo, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="Codice" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Note"
                                                                Width="*"
                                                                Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DockPanel Margin="0,24,0,0" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="Assistenza SMZ"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal">
                                            <Button Content="Aggiungi assistenza SMZ"
                                                    Command="{Binding AddSupportoOccasionaleCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                            <Button Content="Rimuovi selezionato"
                                                    Command="{Binding RemoveSupportoOccasionaleCommand}"
                                                    Style="{DynamicResource DangerButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Usa questa griglia per assistenza SMZ sporadica che non deve entrare in anagrafica. Resta legata solo al singolo servizio."
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <DataGrid Margin="0,16,0,0"
                                              Style="{DynamicResource ServizioWheelDataGridStyle}"
                                              ItemsSource="{Binding ServizioSupportiOccasionaliBozza}"
                                              SelectedItem="{Binding SelectedSupportoOccasionale}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nominativo"
                                                                Width="220"
                                                                Binding="{Binding Nominativo, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Qualifica"
                                                                Width="140"
                                                                Binding="{Binding Qualifica, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Ruolo"
                                                                Width="160"
                                                                Binding="{Binding Ruolo, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Header="Presente"
                                                                    Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Focusable="False"
                                                                  IsChecked="{Binding Presente, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Contatti"
                                                                Width="180"
                                                                Binding="{Binding Contatti, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Note"
                                                                Width="*"
                                                                Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DockPanel Margin="0,24,14,0"
                                               LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="Immersioni del servizio"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right"
                                                Content="Aggiungi immersione"
                                                Command="{Binding AddImmersioneCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Compila solo i ruoli di intestazione per ogni immersione. Direttori e assistenti restano evidenziati nella tabella unica e non vengono conteggiati in acqua nello stesso turno."
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <ItemsControl Margin="0,16,0,0"
                                                  ItemsSource="{Binding ServizioImmersioniBozza}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,14,14"
                                                        Background="#F8FAFC"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="14">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding NumeroImmersione, StringFormat=Immersione {0}}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="Rimuovi"
                                                                    Command="{Binding DataContext.RemoveImmersioneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{DynamicResource DangerButtonStyle}" />
                                                        </DockPanel>

                                                        <Border Margin="0,12,0,0"
                                                                Background="#EEF6FB"
                                                                BorderBrush="#C8DDEB"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="12,10"
                                                                Visibility="Collapsed">
                                                            <StackPanel>
                                                                <DockPanel LastChildFill="False">
                                                                    <TextBlock DockPanel.Dock="Left"
                                                                               Text="Orario immersione"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AppTextBrush}" />
                                                                    <TextBlock DockPanel.Dock="Right"
                                                                               Text="Digita 0830 o 1015, il campo formatta da solo"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               FontSize="11" />
                                                                </DockPanel>

                                                                <StackPanel Margin="0,8,0,0"
                                                                            Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Inizio"
                                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                                   FontSize="11" />
                                                                        <Grid Width="96">
                                                                            <TextBox Style="{DynamicResource ImmersionTimeTextBoxStyle}"
                                                                                     Text="{Binding OrarioInizio, UpdateSourceTrigger=PropertyChanged}"
                                                                                     MaxLength="5"
                                                                                     ToolTip="Digita solo cifre, ad esempio 0830"
                                                                                     infra:TimeInputBehavior.AutoFormat="True" />
                                                                            <TextBlock Text="08:30"
                                                                                       Margin="0,8,0,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       Foreground="#9AAAB5"
                                                                                       IsHitTestVisible="False">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding OrarioInizio}" Value="">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </StackPanel>

                                                                    <TextBlock Margin="12,20,12,0"
                                                                               Text="→"
                                                                               FontSize="18"
                                                                               FontWeight="Bold"
                                                                               Foreground="#4A7087"
                                                                               VerticalAlignment="Center" />

                                                                    <StackPanel>
                                                                        <TextBlock Text="Fine"
                                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                                   FontSize="11" />
                                                                        <Grid Width="96">
                                                                            <TextBox Style="{DynamicResource ImmersionTimeTextBoxStyle}"
                                                                                     Text="{Binding OrarioFine, UpdateSourceTrigger=PropertyChanged}"
                                                                                     MaxLength="5"
                                                                                     ToolTip="Digita solo cifre, ad esempio 1015"
                                                                                     infra:TimeInputBehavior.AutoFormat="True" />
                                                                            <TextBlock Text="10:15"
                                                                                       Margin="0,8,0,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       Foreground="#9AAAB5"
                                                                                       IsHitTestVisible="False">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding OrarioFine}" Value="">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="14" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="Direttore immersione" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                                <ComboBox Margin="0,6,0,0"
                                                                          ItemsSource="{Binding DataContext.OperatoriServizioPresentiDisponibili, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding DirettoreImmersione}"
                                                                          DisplayMemberPath="NominativoConQualifica" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Operatore soccorso" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                                <ComboBox Margin="0,6,0,0"
                                                                          ItemsSource="{Binding DataContext.OperatoriServizioPresentiDisponibili, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding OperatoreSoccorso}"
                                                                          DisplayMemberPath="NominativoConQualifica" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                                <TextBlock Text="Assistenza BLSD" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                                <ComboBox Margin="0,6,0,0"
                                                                          ItemsSource="{Binding DataContext.OperatoriServizioPresentiDisponibili, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding AssistenteBlsd}"
                                                                          DisplayMemberPath="NominativoConQualifica" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                                                <TextBlock Text="Assistenza sanitaria" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                                <ComboBox Margin="0,6,0,0"
                                                                          ItemsSource="{Binding DataContext.OperatoriServizioPresentiDisponibili, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding AssistenteSanitario}"
                                                                          DisplayMemberPath="NominativoConQualifica" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Margin="0,10,0,0" Text="Note immersione" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{DynamicResource ServizioWheelTextBoxStyle}"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 MinHeight="44" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Margin="0,2,14,0"
                                            Background="#F8FAFC"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="14">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="Dettaglio contabile SMZ"
                                                           Foreground="{DynamicResource AppTextBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="Compila una sola riga per operatore: apparato, profondita, ore e categoria vengono applicati automaticamente a tutte le immersioni utili. Correggi solo le eccezioni."
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       TextWrapping="Wrap" />

                                            <DataGrid Margin="0,12,0,0"
                                                      Style="{DynamicResource ServizioWheelDataGridStyle}"
                                                      ItemsSource="{Binding ServizioPartecipazioniContabiliUnicheBozza}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      RowHeaderWidth="0"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRuoliImmersione}" Value="True">
                                                                <Setter Property="Background" Value="#FFF7E6" />
                                                                <Setter Property="BorderBrush" Value="#E7B75F" />
                                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Operatore"
                                                                        Width="250"
                                                                        Binding="{Binding NominativoConQualifica}" />
                                                    <DataGridTextColumn Header="Ruoli"
                                                                        Width="150"
                                                                        Binding="{Binding RuoliImmersione}" />
                                                    <DataGridTemplateColumn Header="Apparato"
                                                                            Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.TipologieImmersioneOperativeCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding TipologiaImmersioneOperativa, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="Descrizione" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Prof."
                                                                            Width="68">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding ProfonditaMetri, UpdateSourceTrigger=LostFocus}"
                                                                         MaxLength="3"
                                                                         ToolTip="{Binding TipologiaImmersioneOperativa.ProfonditaConsentitaDisplay, TargetNullValue='Seleziona prima l''apparato per vedere il range di profondita.'}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Fascia"
                                                                            Width="88">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.FasceProfonditaCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding FasciaProfondita, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="Descrizione" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Ore"
                                                                            Width="68">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding OreImmersione, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Cat."
                                                                            Width="96">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.CategorieContabiliOreCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding CategoriaContabileOre, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="Descrizione" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Tariffa"
                                                                        Width="72"
                                                                        Binding="{Binding TariffaPropostaDisplay}" />
                                                    <DataGridTextColumn Header="Importo"
                                                                        Width="78"
                                                                        Binding="{Binding ImportoStimatoDisplay}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    </Grid>
</UserControl>
