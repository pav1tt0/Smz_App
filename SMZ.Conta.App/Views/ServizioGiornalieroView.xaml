<UserControl x:Class="SMZ.Conta.App.Views.ServizioGiornalieroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SMZ.Conta.App.Controls"
             xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="ServizioWheelDataGridStyle" TargetType="DataGrid">
            <Setter Property="MinHeight" Value="180" />
            <Setter Property="MaxHeight" Value="520" />
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF3" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="ColumnHeaderHeight" Value="NaN" />
            <Setter Property="MinRowHeight" Value="40" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServizioPersonaleTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ServizioPersonaleComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="ServizioPersonaleHeaderTemplate">
            <Border Background="#EFF4F9" BorderBrush="#D5DEE8" BorderThickness="0,0,1,1" Padding="6" MinHeight="34">
                <Grid TextBlock.FontWeight="SemiBold" TextBlock.Foreground="#243B57">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="2*" MinWidth="128" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <ColumnDefinition Width="0.7*" MinWidth="68" />
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Qualifica" Style="{StaticResource ServizioPersonaleTextStyle}" />
                    <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="Nome" Style="{StaticResource ServizioPersonaleTextStyle}" />
                    <TextBlock TextWrapping="Wrap" Grid.Column="2" Text="Presente" Style="{StaticResource ServizioPersonaleTextStyle}" />
                    <TextBlock TextWrapping="Wrap" Grid.Column="3" Text="Ruolo" Style="{StaticResource ServizioPersonaleTextStyle}" />
                    <TextBlock TextWrapping="Wrap" Grid.Column="4" Text="Gruppo" Style="{StaticResource ServizioPersonaleTextStyle}" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="ServizioWheelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
        </Style>
        <Style x:Key="ImmersionTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#9BC2DA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>

                    <Grid Margin="6">
                        <Grid Visibility="{Binding IsElencoServiziVisibile, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <infra:AdaptiveGrid CollapseBelow="900" MinItemWidth="500" MaxColumns="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="Servizi giornalieri"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ServiziSalvatiStato}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="3">
                                        <TextBlock TextWrapping="Wrap" Text="Ricerca servizi"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                         <WrapPanel Margin="0,6,0,0">
    <StackPanel Width="240" Margin="0,0,12,8">
        <TextBlock Text="Localita" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
        <TextBox Text="{Binding ServiziSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cerca per localita" />
    </StackPanel>
    <StackPanel Width="130" Margin="0,0,12,8">
        <TextBlock Text="N. servizio" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
        <TextBox Text="{Binding ServiziNumeroSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Numero servizio" />
    </StackPanel>
    <StackPanel Width="150" Margin="0,0,12,8">
        <TextBlock Text="Data o mese" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
        <controls:DateInputPicker Text="{Binding ServiziDataSearchText, UpdateSourceTrigger=PropertyChanged}" AutoFormatText="False" ShowMonthShortcut="True" Width="145" ToolTip="{Binding ServiziDataSearchToolTip}" />
    </StackPanel>
    <Button Content="Pulisci" Command="{Binding ClearServiziSearchCommand}" Style="{DynamicResource SecondaryButtonStyle}" MinWidth="112" Width="112" Height="42" Margin="0,18,0,8" />
</WrapPanel>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom">
                                        <Button Content="Nuovo"
                                                Command="{Binding NewServizioCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                        <Button Content="Duplica"
                                                Command="{Binding DuplicateServizioCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Elimina"
                                                Command="{Binding DeleteServizioCommand}"
                                                Style="{DynamicResource DangerButtonStyle}" />
                                        <Button Content="Importa"
                                                Command="{Binding ImportServizioPackageCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </infra:AdaptiveGrid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock TextWrapping="Wrap" Text="Elenco servizi compilati"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Text="Sono visibili i servizi recenti; usa la ricerca per trovare quelli piu vecchi."
                                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding ServiziSalvati}"
                                             SelectedItem="{Binding SelectedServizioSalvato}"
                                             MaxHeight="430"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,3"
                                                        Padding="6"
                                                        Background="#F8FAFC"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <Border.ToolTip>
                                                        <ToolTip Placement="Mouse"
                                                                 MaxWidth="420">
                                                            <Border Padding="14"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="#C8D6DF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <StackPanel>
                                                                    <TextBlock TextWrapping="Wrap" Text="{Binding DataServizio, StringFormat=Servizio del {0:dd/MM/yyyy}}"
                                                                               FontSize="16"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AppTextBrush}" />
                                                                    <TextBlock Margin="0,8,0,0"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap">
                                                                        <Run Text="Ordine: " />
                                                                        <Run Text="{Binding NumeroOrdineServizio}" />
                                                                        <Run Text=" - Orario: " />
                                                                        <Run Text="{Binding OrarioServizio}" />
                                                                    </TextBlock>
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap">
                                                                        <Run Text="Tipo: " />
                                                                        <Run Text="{Binding TipoServizio}" />
                                                                    </TextBlock>
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding LocalitaDescrizione, StringFormat=Localita: {0}}"
                                                                               Foreground="{DynamicResource AppTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding ScopoDescrizione, StringFormat=Scopo: {0}}"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding UnitaNavaleDescrizione, StringFormat=Mezzo: {0}}"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                                                                               Foreground="{DynamicResource AppTextBrush}"
                                                                               FontWeight="SemiBold">
                                                                        <Run Text="Presenti " />
                                                                        <Run Text="{Binding PresentiTotali}" />
                                                                        <Run Text=" - Immersioni " />
                                                                        <Run Text="{Binding ImmersioniTotali}" />
                                                                    </TextBlock>
                                                                    <TextBlock Margin="0,7,0,0"
                                                                               Text="{Binding DettaglioImmersioniDescrizione}"
                                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </ToolTip>
                                                    </Border.ToolTip>

                                                    <infra:AdaptiveGrid MinHeight="50" CollapseBelow="1000" MinItemWidth="220" MaxColumns="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="168" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="102" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock TextWrapping="Wrap" Text="{Binding DataServizio, StringFormat={}{0:dd/MM/yyyy}}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TipoServizio}"
                                                                   Foreground="#4F73A5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="Ord. " />
                                                            <Run Text="{Binding NumeroOrdineServizio}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding OrarioServizio}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding LocalitaDescrizione}"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="4"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}">
                                                            <Run Text="Presenti " />
                                                            <Run Text="{Binding PresentiTotali}" />
                                                        </TextBlock>
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="5"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   Text="{Binding ImmersioniTotali, StringFormat=Immersioni: {0}}" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="2"
                                                                   Grid.ColumnSpan="4"
                                                                   Margin="0,4,8,0"
                                                                   Text="{Binding DettaglioImmersioniDescrizione}"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DettaglioImmersioniDescrizione}" />
                                                        <Button Grid.Column="6"
                                                                Grid.RowSpan="2"
                                                                Content="Apri"
                                                                Width="96"
                                                                MinWidth="0"
                                                                Height="26"
                                                                Padding="8,1"
                                                                Margin="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.OpenServizioFromListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                    </infra:AdaptiveGrid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsSchedaServizioVisibile, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <infra:AdaptiveGrid CollapseBelow="1000" MinItemWidth="600" MaxColumns="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <Button Content="Torna elenco"
                                                Command="{Binding CloseSchedaServizioCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="Salva"
                                                Command="{Binding SaveServizioCommand}" />
                                        <Button Content="Stampa servizio"
                                                Command="{Binding PrintServizioCommand}"
                                                Visibility="{Binding IsServizioApertoDaReport, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock TextWrapping="Wrap" Text="{Binding ServizioEditorTitolo}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ServizioBozzaStato}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </infra:AdaptiveGrid>
                            </Border>

                            <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                            <ScrollViewer x:Name="ServizioEditorScrollViewer"
                                          infra:MouseWheelScrollViewerBehavior.ForwardToParent="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource ServizioWheelDataGridStyle}" />
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ServizioWheelTextBoxStyle}" />
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
                                    </Style>
                                    <Style TargetType="controls:DateInputPicker">
                                        <Setter Property="infra:MouseWheelScrollViewerBehavior.ForwardToParent" Value="True" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="{Binding ServizioEditorSottotitolo}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <Border Margin="0,16,0,0"
                                            Background="#F8FAFC"
                                            CornerRadius="18"
                                            Padding="16">
                                        <StackPanel x:Name="ServizioDatiGenerali">
                                            <infra:AdaptiveGrid CollapseBelow="520" MinItemWidth="160" MaxColumns="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Data servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <controls:DateInputPicker Text="{Binding ServizioData, UpdateSourceTrigger=PropertyChanged}"
                                                                              ToolTip="Seleziona la data dal calendario oppure scrivila in formato gg/mm/aaaa" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="N. ordine servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <TextBox Text="{Binding ServizioNumeroOrdine, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="40"
                                                             ToolTip="Calcolato automaticamente dalla data come giorno progressivo dell'anno; puo essere modificato." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Tipo servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <ComboBox ItemsSource="{Binding TipiServizioDisponibili}"
                                                              SelectedItem="{Binding ServizioTipoSelezionato}" />
                                                </StackPanel>
                                            </infra:AdaptiveGrid>

                                            <ScrollViewer Margin="0,10,0,0"
                                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                          infra:MouseWheelScrollViewerBehavior.ForwardToParent="True">
                                                <Grid x:Name="ServizioOrariGrid" MinWidth="520">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Orario servizio" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                    <ComboBox Grid.Row="1" VerticalAlignment="Center"
                                                              ItemsSource="{Binding OrariServizioFissiDisponibili}"
                                                              SelectedItem="{Binding ServizioOrarioFissoSelezionato}"
                                                              ToolTip="Seleziona uno degli orari fissi del servizio" />
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                                        <CheckBox x:Name="ServizioDerogaCheckBox" VerticalAlignment="Center"
                                                                  IsChecked="{Binding ServizioOrarioDerogaAttiva}" Content="Orario in deroga" />
                                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                                    Visibility="{Binding ServizioOrarioDerogaAttiva, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Da" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                            <TextBox Width="68" Margin="0" MaxLength="5"
                                                                     Text="{Binding ServizioOrarioDerogaInizio, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="Inizio orario in deroga, esempio 07:30" infra:TimeInputBehavior.AutoFormat="True" />
                                                            <TextBlock Text="a" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                            <TextBox Width="68" Margin="0" MaxLength="5"
                                                                     Text="{Binding ServizioOrarioDerogaFine, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="Fine orario in deroga, esempio 14:15" infra:TimeInputBehavior.AutoFormat="True" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>

                                            <ScrollViewer Margin="0,12,0,0"
                                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                          infra:MouseWheelScrollViewerBehavior.ForwardToParent="True">
                                                <Grid x:Name="ServizioIndennitaGrid" MinWidth="520">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <CheckBox x:Name="ServizioStraordinarioCheckBox" Content="Lavoro straordinario"
                                                              VerticalAlignment="Center" IsChecked="{Binding ServizioStraordinarioAttivo}" />
                                                    <CheckBox x:Name="ServizioFuoriSedeCheckBox" Grid.Column="2" Content="Indennita fuori sede"
                                                              VerticalAlignment="Center" IsChecked="{Binding ServizioFuoriSede}"
                                                              ToolTip="Non cumulabile con l'indennita di ordine pubblico." />
                                                    <CheckBox x:Name="ServizioOpCheckBox" Grid.Column="4" Content="Indennita OP"
                                                              VerticalAlignment="Center" IsChecked="{Binding ServizioIndennitaOrdinePubblico}"
                                                              ToolTip="Indennita di ordine pubblico, non cumulabile con l'indennita fuori sede." />
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0"
                                                                Visibility="{Binding ServizioStraordinarioAttivo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Straordinario da" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Width="68" Margin="0" MaxLength="5"
                                                                 Text="{Binding ServizioStraordinarioInizio, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Inizio straordinario, esempio 18:30" infra:TimeInputBehavior.AutoFormat="True" />
                                                        <TextBlock Text="a" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <TextBox Width="68" Margin="0" MaxLength="5"
                                                                 Text="{Binding ServizioStraordinarioFine, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Fine straordinario, esempio 21:15" infra:TimeInputBehavior.AutoFormat="True" />
                                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                                                   Text="{Binding ServizioStraordinarioOreDisplay}"
                                                                   Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>

                                            <ScrollViewer Margin="0,12,0,0"
                                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                          infra:MouseWheelScrollViewerBehavior.ForwardToParent="True">
                                                <Grid x:Name="ServizioNatantiGrid" MinWidth="520">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Localita" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <ComboBox ItemsSource="{Binding LocalitaOperativeServizioCatalogo}"
                                                                  SelectedItem="{Binding ServizioLocalitaSelezionata}" DisplayMemberPath="Descrizione" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Natante 1" Foreground="{DynamicResource AppMutedTextBrush}" />
                                                        <ComboBox ItemsSource="{Binding UnitaNavaliCatalogo}"
