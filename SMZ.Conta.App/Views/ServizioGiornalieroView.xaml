                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding NumeriImmersioneRuolo}" LineHeight="20"
                                                                               Visibility="{Binding HasIncarichiImmersione, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                               ToolTip="Immersioni degli incarichi selezionati sopra." />
                                                                    <ComboBox ItemsSource="{Binding ImmersioniDisponibili}"
                                                                              SelectedItem="{Binding NumeroImmersione, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Visibility="{Binding MostraSceltaImmersione, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                              ToolTip="Scegli l'immersione come operatore subacqueo." />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Ruolo" Width="200" MinWidth="200">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding RuoliImmersione}" LineHeight="20" ToolTip="{Binding RuoliImmersione}" />
                                                                    <TextBlock Text="Operatore subacqueo" Margin="0,6,0,0" MinHeight="28" VerticalAlignment="Center"
                                                                               Visibility="{Binding MostraRuoloOperatore, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Apparato"
                                                                            Width="120" MinWidth="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.TipologieImmersioneOperativeCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding TipologiaImmersioneOperativa, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="Descrizione" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Prof."
                                                                            Width="68" MinWidth="68">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding ProfonditaMetri, UpdateSourceTrigger=LostFocus}"
                                                                         MaxLength="3"
                                                                         ToolTip="{Binding TipologiaImmersioneOperativa.ProfonditaConsentitaDisplay, TargetNullValue='Seleziona prima l''apparato per vedere il range di profondita.'}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Fascia"
                                                                            Width="88" MinWidth="88">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.FasceProfonditaCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding FasciaProfondita, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="Descrizione" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Ore"
                                                                            Width="68" MinWidth="68">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding OreImmersione, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Cat."
                                                                            Width="96" MinWidth="96">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.CategorieContabiliOreCatalogo, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding CategoriaContabileOre, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="Descrizione" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Tariffa"
                                                                        Width="72" MinWidth="72"
                                                                        Binding="{Binding TariffaPropostaDisplay}" />
                                                    <DataGridTextColumn Header="Importo"
                                                                        Width="78" MinWidth="78"
                                                                        Binding="{Binding ImportoStimatoDisplay}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Salva servizio" HorizontalAlignment="Right" Margin="0,18,0,0"
                                            Command="{Binding SaveServizioCommand}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    </Grid>
</UserControl>
