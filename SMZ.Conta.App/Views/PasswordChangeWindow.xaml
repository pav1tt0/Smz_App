<Window x:Class="SMZ.Conta.App.Views.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambio password" Width="470" Height="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F6FA" FontFamily="Bahnschrift">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Cambia password" FontSize="25" FontWeight="SemiBold" Foreground="#0D1B3D" />
            <TextBlock x:Name="DescriptionText" Margin="0,8,0,16" Foreground="#52647A" TextWrapping="Wrap" />
            <TextBlock Text="Password attuale" />
            <PasswordBox x:Name="CurrentPasswordInput" Height="40" Margin="0,5,0,14" Padding="10,7" />
            <TextBlock Text="Nuova password" />
            <PasswordBox x:Name="NewPasswordInput" Height="40" Margin="0,5,0,14" Padding="10,7" />
            <TextBlock Text="Conferma nuova password" />
            <PasswordBox x:Name="ConfirmationInput" Height="40" Margin="0,5,0,0" Padding="10,7" />
            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="#D40F1F" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="110" Height="40" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Salva" Width="110" Height="40" Click="SaveButton_Click" IsDefault="True"
                    Background="#0E5AA7" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
