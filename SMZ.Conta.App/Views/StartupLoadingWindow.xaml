<Window x:Class="SMZ.Conta.App.Views.StartupLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avvio SMZ"
        Icon="/SMZ.App;component/Assets/logo_smz.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#071528"
        FontFamily="Bahnschrift">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/SMZ.App;component/Assets/smz.jpg"
                        Stretch="UniformToFill" />
        </Grid.Background>

        <Border Background="#E6071528" />

        <StackPanel Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="SMZ LA SPEZIA"
                       HorizontalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontSize="30"
                       FontWeight="Bold" />
            <TextBlock Margin="0,16,0,20"
                       Text="Caricamento in corso..."
                       HorizontalAlignment="Center"
                       Foreground="#DDEEFF"
                       FontSize="19"
                       FontWeight="SemiBold" />
            <ProgressBar Height="7"
                         IsIndeterminate="True"
                         Foreground="#5CA8F2"
                         Background="#294B6D" />
            <TextBlock Margin="0,14,0,0"
                       Text="Apertura della schermata principale"
                       HorizontalAlignment="Center"
                       Foreground="#AFC8DF"
                       FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
