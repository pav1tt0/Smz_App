<UserControl x:Class="SMZ.Conta.App.Views.BackupArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Backup dati"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding BackupDescrizione}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,12,0,0"
                                               Text="{Binding BackupLocaleStato}"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding BackupEsternoStato}"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding BackupCartellaEsterna, StringFormat=Cartella esterna: {0}}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Width="250">
                                    <Button Content="Crea backup locale"
                                            Command="{Binding CreateLocalBackupCommand}" />
                                    <Button Content="Crea backup esterno"
                                            Margin="0,10,0,0"
                                            Command="{Binding CreateExternalBackupCommand}" />
                                    <Button Content="Configura cartella esterna"
                                            Margin="0,10,0,0"
                                            Command="{Binding ConfigureExternalBackupDirectoryCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                    <Button Content="Ripristina da backup"
                                            Margin="0,10,0,0"
                                            Command="{Binding RestoreBackupCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Backup e archivio"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,10,0,0"
                                           Text="Elenco delle schede eliminate dalla parte operativa e ancora recuperabili."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <DataGrid Grid.Row="2"
                                          Margin="0,16,0,0"
                                          ItemsSource="{Binding ArchivioItems}"
                                          SelectedItem="{Binding SelectedArchivio}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserResizeColumns="False"
                                          FrozenColumnCount="1"
                                          IsReadOnly="True"
                                          MinHeight="520"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Azioni"
                                                                Width="310">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Ripristina"
                                                                Width="130"
                                                                Padding="10,6"
                                                                Command="{Binding DataContext.RestoreArchivioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Elimina"
                                                                Width="120"
                                                                Margin="12,0,0,0"
                                                                Padding="10,6"
                                                                Command="{Binding DataContext.DeleteArchivioDefinitivoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{DynamicResource DangerButtonStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Cognome"
                                                            Width="180"
                                                            Binding="{Binding Cognome}" />
                                        <DataGridTextColumn Header="Nome"
                                                            Width="180"
                                                            Binding="{Binding Nome}" />
                                        <DataGridTextColumn Header="PerID"
                                                            Width="80"
                                                            Binding="{Binding PerIdOriginale}" />
                                        <DataGridTextColumn Header="Codice fiscale"
                                                            Width="170"
                                                            Binding="{Binding CodiceFiscale}" />
                                        <DataGridTextColumn Header="Archiviazione"
                                                            Width="165"
                                                            Binding="{Binding DataArchiviazione, StringFormat=dd/MM/yyyy HH:mm}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
</UserControl>
