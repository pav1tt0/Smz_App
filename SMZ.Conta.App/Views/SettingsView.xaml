<UserControl x:Class="SMZ.Conta.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Impostazioni operative"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#17313E" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="Cataloghi e tariffe sono separati dalle pagine operative per evitare modifiche accidentali durante l'uso quotidiano."
                                           Foreground="#53646A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Localita operative"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17313E" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="Modifica descrizione, provincia, ordine e stato attivo delle localita usate nei servizi."
                                                       Foreground="#53646A"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right"
                                                Content="Salva localita"
                                                Command="{Binding SaveLocalitaOperativeCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </DockPanel>

                                    <DockPanel Grid.Row="1"
                                               Margin="0,14,0,0"
                                               LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Margin="10,0,0,0"
                                                MinWidth="96"
                                                Content="Aggiungi"
                                                Command="{Binding AddLocalitaOperativaCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <TextBox Text="{Binding NuovaLocalitaOperativa, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80"
                                                 ToolTip="Aggiunge una localita permanente nel menu" />
                                    </DockPanel>

                                    <DataGrid Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding LocalitaOperativeCatalogo}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              MinHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID"
                                                                Width="60"
                                                                IsReadOnly="True"
                                                                Binding="{Binding LocalitaOperativaId}" />
                                            <DataGridTextColumn Header="Descrizione"
                                                                Width="*"
                                                                Binding="{Binding Descrizione, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Prov."
                                                                Width="80"
                                                                Binding="{Binding Provincia, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Ordine"
                                                                Width="80"
                                                                Binding="{Binding Ordine, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridCheckBoxColumn Header="Attiva"
                                                                    Width="80"
                                                                    Binding="{Binding Attiva, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Mezzi nautici"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17313E" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="Modifica descrizione, sigla, ordine e stato attivo dei mezzi disponibili nel servizio giornaliero."
                                                       Foreground="#53646A"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right"
                                                Content="Salva mezzi"
                                                Command="{Binding SaveUnitaNavaliCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </DockPanel>

                                    <DockPanel Grid.Row="1"
                                               Margin="0,14,0,0"
                                               LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Margin="10,0,0,0"
                                                MinWidth="96"
                                                Content="Aggiungi"
                                                Command="{Binding AddUnitaNavaleCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <TextBox Text="{Binding NuovaUnitaNavale, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80"
                                                 ToolTip="Aggiunge un mezzo nautico permanente nel menu" />
                                    </DockPanel>

                                    <DataGrid Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding UnitaNavaliGestioneCatalogo}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              MinHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID"
                                                                Width="60"
                                                                IsReadOnly="True"
                                                                Binding="{Binding UnitaNavaleId}" />
                                            <DataGridTextColumn Header="Descrizione"
                                                                Width="*"
                                                                Binding="{Binding Descrizione, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Sigla"
                                                                Width="90"
                                                                Binding="{Binding Sigla, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Ordine"
                                                                Width="80"
                                                                Binding="{Binding Ordine, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridCheckBoxColumn Header="Attiva"
                                                                    Width="80"
                                                                    Binding="{Binding Attiva, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4"
                                Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Tariffe contabili"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17313E" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding TariffeContabiliStato}"
                                                   Foreground="#53646A"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right"
                                            Content="Salva tariffe"
                                            Command="{Binding SaveTariffeContabiliCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </DockPanel>

                                <TextBlock Grid.Row="1"
                                           Margin="0,12,0,0"
                                           Text="Le tariffe salvate restano nel database e vengono usate nei calcoli contabili successivi."
                                           Foreground="#6A7B80"
                                           TextWrapping="Wrap" />

                                <DataGrid Grid.Row="2"
                                          Margin="0,16,0,0"
                                          ItemsSource="{Binding RegoleContabiliEditorItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          MinHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Apparato"
                                                            Width="170"
                                                            IsReadOnly="True"
                                                            Binding="{Binding TipologiaDescrizione}" />
                                        <DataGridTextColumn Header="Fascia"
                                                            Width="110"
                                                            IsReadOnly="True"
                                                            Binding="{Binding FasciaDescrizione}" />
                                        <DataGridTextColumn Header="Categoria"
                                                            Width="130"
                                                            IsReadOnly="True"
                                                            Binding="{Binding CategoriaDescrizione}" />
                                        <DataGridTextColumn Header="Tariffa"
                                                            Width="110"
                                                            Binding="{Binding Tariffa, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridCheckBoxColumn Header="Attiva"
                                                                Width="90"
                                                                Binding="{Binding Attiva, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
</UserControl>
