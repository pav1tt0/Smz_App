<UserControl x:Class="SMZ.Conta.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SMZ.Conta.App.Infrastructure">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Amministrazione"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="Gestisci utenti, livelli di accesso, cataloghi operativi e tariffe del gestionale."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <infra:AdaptiveGrid Grid.Row="4" CollapseBelow="1000" MinItemWidth="500" MaxColumns="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <infra:AdaptiveGrid CollapseBelow="800" MinItemWidth="450" MaxColumns="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="Localita operative"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="Modifica descrizione, provincia, ordine e stato attivo delle localita usate nei servizi."
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Salva localita"
                                                Command="{Binding SaveLocalitaOperativeCommand}"
                                                MinWidth="128"
                                                Margin="0"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </infra:AdaptiveGrid>

                                    <infra:AdaptiveGrid Grid.Row="1"
                                               Margin="0,14,0,0" CollapseBelow="520" MinItemWidth="600" MaxColumns="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="2"
                                                Margin="10,0,0,0"
                                                MinWidth="96"
                                                Content="Aggiungi"
                                                Command="{Binding AddLocalitaOperativaCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <TextBox Grid.Column="0" Text="{Binding NuovaLocalitaOperativa, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80"
                                                 ToolTip="Aggiunge una localita permanente nel menu" />
                                    </infra:AdaptiveGrid>

                                    <DataGrid Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding LocalitaOperativeCatalogo}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              MinHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID"
                                                                Width="60" MinWidth="60"
                                                                IsReadOnly="True"
                                                                Binding="{Binding LocalitaOperativaId}" />
                                            <DataGridTextColumn Header="Descrizione"
                                                                Width="*" MinWidth="240"
                                                                Binding="{Binding Descrizione, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Prov."
                                                                Width="80" MinWidth="80"
                                                                Binding="{Binding Provincia, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Ordine"
                                                                Width="80" MinWidth="80"
                                                                Binding="{Binding Ordine, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridCheckBoxColumn Header="Attiva"
                                                                    Width="80" MinWidth="80"
                                                                    Binding="{Binding Attiva, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <infra:AdaptiveGrid CollapseBelow="800" MinItemWidth="450" MaxColumns="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="Mezzi nautici"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="Modifica descrizione, sigla, ordine e stato attivo dei mezzi disponibili nel servizio giornaliero."
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Salva mezzi"
                                                Command="{Binding SaveUnitaNavaliCommand}"
                                                MinWidth="128"
                                                Margin="0"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </infra:AdaptiveGrid>

                                    <infra:AdaptiveGrid Grid.Row="1"
                                               Margin="0,14,0,0" CollapseBelow="520" MinItemWidth="600" MaxColumns="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="2"
                                                Margin="10,0,0,0"
                                                MinWidth="96"
                                                Content="Aggiungi"
                                                Command="{Binding AddUnitaNavaleCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                        <TextBox Grid.Column="0" Text="{Binding NuovaUnitaNavale, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80"
                                                 ToolTip="Aggiunge un mezzo nautico permanente nel menu" />
                                    </infra:AdaptiveGrid>

                                    <DataGrid Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding UnitaNavaliGestioneCatalogo}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              MinHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID"
                                                                Width="60" MinWidth="60"
                                                                IsReadOnly="True"
                                                                Binding="{Binding UnitaNavaleId}" />
                                            <DataGridTextColumn Header="Descrizione"
                                                                Width="*" MinWidth="240"
                                                                Binding="{Binding Descrizione, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Sigla"
                                                                Width="90" MinWidth="90"
                                                                Binding="{Binding Sigla, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Ordine"
                                                                Width="80" MinWidth="80"
                                                                Binding="{Binding Ordine, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridCheckBoxColumn Header="Attiva"
                                                                    Width="80" MinWidth="80"
                                                                    Binding="{Binding Attiva, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </infra:AdaptiveGrid>

                        <Border Grid.Row="6"
                                Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <infra:AdaptiveGrid CollapseBelow="800" MinItemWidth="450" MaxColumns="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="Tariffe contabili"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding TariffeContabiliStato}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Salva tariffe"
                                            Command="{Binding SaveTariffeContabiliCommand}"
                                            MinWidth="128"
                                            Margin="0"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </infra:AdaptiveGrid>

                                <TextBlock Grid.Row="1"
                                           Margin="0,12,0,0"
                                           Text="Inserisci la tariffa oraria finale della categoria: ADD gia ridotta del 50%, C.I. gia ridotta del 20%, SPER gia maggiorata del 25%. Riepilogo e contabilita moltiplicano questa tariffa per le ore, senza applicare altri coefficienti."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <DataGrid Grid.Row="2"
                                          Margin="0,16,0,0"
                                          ItemsSource="{Binding RegoleContabiliEditorItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          MinHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Apparato"
                                                            Width="170" MinWidth="170"
                                                            IsReadOnly="True"
                                                            Binding="{Binding TipologiaDescrizione}" />
                                        <DataGridTextColumn Header="Fascia"
                                                            Width="110" MinWidth="110"
                                                            IsReadOnly="True"
                                                            Binding="{Binding FasciaDescrizione}" />
                                        <DataGridTextColumn Header="Categoria"
                                                            Width="130" MinWidth="130"
                                                            IsReadOnly="True"
                                                            Binding="{Binding CategoriaDescrizione}" />
                                        <DataGridTextColumn Header="Tariffa"
                                                            Width="110" MinWidth="110"
                                                            Binding="{Binding Tariffa, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridCheckBoxColumn Header="Attiva"
                                                                Width="90" MinWidth="90"
                                                                Binding="{Binding Attiva, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <infra:AdaptiveGrid CollapseBelow="800" MinItemWidth="450" MaxColumns="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="Gestione utenti"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="Account identificati dal PerID. Le password reimpostate devono essere cambiate al primo accesso."
                                                   Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Nuovo account"
                                            Command="{Binding CreateAccessUserCommand}"
                                            Margin="16,0,0,0" MinWidth="140"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                </infra:AdaptiveGrid>

                                <WrapPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal">
                                    <Button Content="Reset password" Command="{Binding ResetAccessPasswordCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                    <Button Content="{Binding SelectedAccessUserActionLabel}"
                                            Command="{Binding ToggleAccessUserCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                    <Button Content="{Binding SelectedAccessUserRoleActionLabel}"
                                            Command="{Binding ToggleAccessRoleCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                </WrapPanel>

                                <DataGrid Grid.Row="2" Margin="0,16,0,0"
                                          ItemsSource="{Binding AccessUsers}"
                                          SelectedItem="{Binding SelectedAccessUser}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                                          MinHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PerID" Width="90" MinWidth="90" Binding="{Binding PerId}" />
                                        <DataGridTextColumn Header="Nominativo" Width="*" MinWidth="220" Binding="{Binding DisplayName}" />
                                        <DataGridTextColumn Header="Profilo" Width="150" MinWidth="150" Binding="{Binding RoleDisplayName}" />
                                        <DataGridTextColumn Header="Stato" Width="110" MinWidth="110" Binding="{Binding StatusDisplayName}" />
                                        <DataGridTextColumn Header="Ultimo accesso" Width="170" MinWidth="170" Binding="{Binding LastAccessDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
</UserControl>
